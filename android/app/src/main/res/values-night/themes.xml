<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window shows before Compose draws; match the dark PersonaTheme instead of flashing white. -->
    <style name="Theme.Persona" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Tells WebView the app theme is dark so pages declaring prefers-color-scheme: dark render in dark mode. -->
        <item name="android:isLightTheme">false</item>
    </style>
</resources>
