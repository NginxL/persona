{
  "sourceLanguage": "en",
  "strings": {
    "NSAlarmKitUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona sets alarms and timers only when you ask and approve it on your iPhone, for example to wake you at 6:40 or to start a 25-minute focus timer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依頼してiPhoneで承認したときだけ、Personaがアラームやタイマーを設定します。たとえば6時40分に起こしたり、25分の集中タイマーを始めたりします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你让 Persona 设闹钟或计时器、并在 iPhone 上同意后，它才会设置，比如 6:40 叫你起床，或开一个 25 分钟的专注计时器。"
          }
        }
      }
    },
    "NSAppleMusicUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona plays Apple Music when you ask, for example a playlist for focused work, and can pause or skip what the Music app is playing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依頼したときにPersonaがApple Musicを再生します。たとえば集中作業向けのプレイリストを流したり、ミュージックAppで再生中の曲を一時停止やスキップしたりします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你让 Persona 放歌时，它会播放 Apple Music，比如适合专注工作的歌单，也能暂停或切换「音乐」App 正在放的歌。"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona lets Claude read and add calendar events when you ask, for example to check whether you are free on Friday afternoon or to book a meeting. It also names a meeting recording after the event happening now."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依頼したときにClaudeがカレンダーの予定を読み取り、追加できるようにします。たとえば金曜の午後が空いているか確認したり、会議を入れたりします。会議の録音には進行中の予定の名前を付けます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你让 Claude 看日程时，Persona 允许它读取和添加日历事件，比如看看周五下午有没有空，或者约一个会。会议录音也会用正在进行的日程命名。"
          }
        }
      }
    },
    "NSCalendarsWriteOnlyAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona adds events to your calendar when you ask Claude to, for example to save a meeting it scheduled for you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claudeに依頼したときに、Personaがカレンダーに予定を追加します。たとえばClaudeが調整した会議を保存します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你让 Claude 添加日程时，Persona 把事件写进日历，比如保存它帮你约好的会议。"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona uses the camera to scan the pairing QR code printed by `personad hub pair`, and to take a photo you add to a chat or a meeting, for example a whiteboard during a meeting."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Personaはカメラで`personad hub pair`が表示するペアリング用QRコードを読み取り、チャットや会議に追加する写真を撮ります。たとえば会議中のホワイトボードを撮るときに使います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona 用相机扫描 `personad hub pair` 打印的配对二维码，也用来拍你要加到聊天或会议里的照片，比如会上的白板。"
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona lets Claude look up your contacts when you ask, for example to find a colleague's phone number or email before drafting a message."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依頼したときにClaudeが連絡先を調べられるようにします。たとえばメッセージを下書きする前に同僚の電話番号やメールアドレスを探します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你让 Claude 查联系人时，Persona 允许它读取通讯录，比如起草消息前找到同事的电话或邮箱。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona asks for Face ID before it types a Mac's remembered password on that Mac's lock screen, when you tap One-Tap Unlock on the Mac's page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macのページで「ワンタップで解除」をタップすると、PersonaはFace IDで確認してから、そのMacのロック画面に保存済みのパスワードを入力します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 的页面上点「一键解锁」时，Persona 先用面容 ID 确认，再在那台 Mac 的锁屏上输入记住的密码。"
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona lets Claude read health summaries when you ask, for example how many steps you walked this week or how long you slept last night. With rolling recording on, Persona also checks heart rate, HRV, steps, workouts and the moods you log, on your iPhone only, to keep the minutes around them. The Health home and widgets show Activity rings, steps and sleep."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依頼したときにClaudeがヘルスケアの概要を読み取れるようにします。たとえば今週の歩数や昨夜の睡眠時間です。ローリング録音をオンにすると、心拍、HRV、歩数、ワークアウト、記録した気分もiPhone上だけで確認し、その前後の数分を残します。健康のホームとウィジェットには、アクティビティリング、歩数、睡眠が表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你让 Claude 看健康数据时，Persona 允许它读取健康摘要，比如这周走了多少步、昨晚睡了多久。开启滚动录音后，还会在 iPhone 本机查看心率、HRV、步数、锻炼和你记下的心境，用来保留这些信号前后几分钟。健康主页和小组件会显示健身圆环、步数和睡眠。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona saves individual health samples after you confirm them on your iPhone. When you turn on sync, Persona also automatically writes your water and protein records to Apple Health on this iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PersonaはiPhoneで確認した健康データを1件ずつ保存します。同期をオンにすると、水分とたんぱく質の記録もこのiPhoneのAppleヘルスケアに自動で書き込みます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona 会在你在 iPhone 上确认后保存单条健康数据。打开同步后，Persona 还会自动将饮水和蛋白质记录写入这台 iPhone 的 Apple 健康。"
          }
        }
      }
    },
    "NSHomeKitUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona controls your Home accessories and scenes only when you ask and approve each change on your iPhone, for example to turn off the living room light."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依頼してiPhoneで変更ごとに承認したときだけ、Personaがホームのアクセサリやシーンを操作します。たとえばリビングの照明を消します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你让 Persona 控制家居、并在 iPhone 上逐项同意后，它才会操作配件和场景，比如关掉客厅的灯。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona connects straight to your computer when it's on the same Wi-Fi, to show its screen faster."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ Wi-Fi にあるコンピュータに直接つないで、その画面をより速く表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona 在你和电脑连着同一个 Wi-Fi 时直接连到电脑，让电脑屏幕显示得更快。"
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona reads your location only when the assistant needs it to answer you, for example when you ask “How far am I from home?” while Persona isn't open. When you move a long way, iOS may wake Persona in the background, but it doesn't record where you go."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Personaが位置情報を読み取るのは、アシスタントが質問に答えるのに必要なときだけです。たとえばPersonaを開いていないときに「家まであとどれくらい？」と尋ねた場合です。大きく移動したときは、iOSがバックグラウンドでPersonaを起動することがありますが、移動の記録は残しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在助手需要回答你的问题时才读取位置，例如你没打开 Persona 时问「我离家还有多远」。你移动较远时，iOS 可能会在后台唤醒 Persona，但它不会记录你的行踪。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona shares your current location with Claude only when you ask, for example to find what time it is where you are or which office you are in."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依頼したときだけ、Personaは現在地をClaudeに伝えます。たとえば今いる場所の時刻や、どのオフィスにいるかを調べます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你让 Claude 用位置时，Persona 才把当前位置告诉它，比如查你所在地的时间，或者你在哪个办公室。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona records audio when you start a recording or dictate a message, for example a meeting or a spoken note. Recordings are transcribed on your iPhone and only the text is saved to the knowledge base on your hub; the audio stays on your iPhone, except while Talk is on in a meeting: what is said then goes to the voice service. A meeting you choose to transcribe on the hub sends its audio, Talk included, through your hub to the speech service it is set up with, and the hub deletes it once the meeting's minutes are written. In a voice conversation or a call to Persona you start — on the phone, in CarPlay or with Siri — your voice is streamed through your hub to the realtime speech service it is set up with, only while it lasts. On an urgent call you answer, Persona listens on your iPhone and only the text of what you say goes to your hub."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音や音声入力を始めたときにPersonaが録音します。たとえば会議や口頭のメモです。録音はiPhone上で文字起こしされ、テキストだけがハブのナレッジに保存されます。音声はiPhoneに残ります。ただし会議で「話す」がオンの間は例外で、そのときに話された内容は音声サービスに送られます。ハブで文字起こしすることを選んだ会議は、その音声（「話す」を含む）をハブ経由で、ハブに設定された音声サービスに送ります。ハブは会議の議事録ができた時点でその音声を削除します。あなたが始めた音声会話やPersonaへの電話では（iPhoneでも、CarPlayでも、Siriからでも）、会話中または通話中に限り、あなたの声がハブを経由して、ハブに設定されたリアルタイム音声サービスに送られます。緊急コールに出たときは、PersonaがiPhone上であなたの声を聞き取り、話した内容のテキストだけをハブに送ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你开始录音或语音输入时，Persona 会录音，比如录一场会议或一段口述笔记。录音在 iPhone 上转成文字，只有文字存进 hub 上的知识库，音频留在 iPhone 上；只有在会议里打开“说话”时例外：那时说的内容会发送到语音服务。你选择在 hub 上转写的会议，会把它的音频（包括“说话”）经 hub 传给它配置的语音服务，会议纪要写好后 hub 就删除这段音频。你发起语音对话或呼叫 Persona 时（在手机上、CarPlay 里或通过 Siri），只在对话或通话进行中把你的声音经 hub 传给它配置的实时语音服务。接起加急来电时，Persona 在 iPhone 上听你说话，只把你说的话的文字发到 hub。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona saves images Claude produces to your library when you ask, for example a chart it generated."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依頼したときに、Claudeが作成した画像をPersonaが写真ライブラリに保存します。たとえば生成したグラフです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你让 Persona 保存时，它把 Claude 生成的图片存进照片图库，比如它画的图表。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona shows your recent photos under the + button so you can attach them to a message, and lets Claude look at recent photos when you ask, for example to read a screenshot you took."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "＋ボタンの下に最近の写真を表示してメッセージに添付できるようにします。また依頼したときにClaudeが最近の写真を見られるようにします。たとえば撮ったスクリーンショットを読みます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona 会在 + 按钮下列出你最近的照片，方便附到消息里；你让 Claude 看照片时，也允许它查看最近的照片，比如读一张截图。"
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona lets Claude read and create reminders when you ask, for example to add “review the PR” to your Today list."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依頼したときにClaudeがリマインダーを読み取り、作成できるようにします。たとえば「PRを確認する」を今日のリストに追加します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你让 Claude 管提醒事项时，Persona 允许它读取和新建提醒，比如把「看一下 PR」加到今天的列表里。"
          }
        }
      }
    },
    "NSSiriUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona uses Siri so you can call Persona by saying “Call Persona using Persona”. Siri passes the call to Persona, which calls the assistant on your hub; Persona shares nothing else with Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「PersonaでPersonaに電話して」と言うだけでPersonaに電話できるよう、PersonaはSiriを使います。Siriは通話をPersonaに渡し、Personaがハブのアシスタントに電話します。PersonaがSiriにほかの情報を渡すことはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona 使用 Siri，让你说“用 Persona 打给 Persona”就能打给 Persona。Siri 把这通电话交给 Persona，由它打给 hub 上的助手；Persona 不会把其他任何内容交给 Siri。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona turns your voice into text when you use the mic button, for example to dictate a reply to Claude, and on an urgent call you answer, to hear what you decide. It does this on your iPhone when it can."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクボタンを使用すると、Personaがあなたの声をテキストに変換します。たとえばClaudeへの返信を音声で入力します。緊急コールに出たときも、あなたの決定を聞き取るのに使います。できるときはiPhone上で変換します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用麦克风按钮时，Persona 把你的语音转成文字，比如口述一条给 Claude 的回复；接起加急来电时，也用它听你的决定。能在 iPhone 上转的都在 iPhone 上转。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
