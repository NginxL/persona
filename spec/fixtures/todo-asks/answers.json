    {
      "name": "decision_recommended_option",
      "description": "OK on the recommended option takes the recommendation: it goes to the to-do's Agent and the decision leaves the row.",
      "source": [
        "docs/design/proposals/todos-redesign.md 3.7",
        "server/internal/assistant/decision.go chooseOption"
      ],
      "input": {
        "state": "decision",
        "ask": "todo:decision@2026-11-10T09:00:00Z",
        "answer": {
          "option": "Ryokan Hanami"
        }
      },
      "expected": {
        "status": 200,
        "answered": {
          "ask": "todo:decision@2026-11-10T09:00:00Z",
          "outcome": "answered"
        },
        "sent": true,
        "waits": false
      }
    },
