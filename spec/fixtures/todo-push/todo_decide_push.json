      "name": "older_manager_unchanged",
      "description": "A manager from before #10465 names no lock-screen rule: the push is exactly as before, TODO_DECIDE with Take Recommendation, and the options it sends are not forwarded.",
      "source": [
        "docs/assistant/todos.md \"Waiting for the owner\"",
        "docs/design/proposals/todos-redesign.md 3.7"
      ],
      "input": {
        "owner": "assistant",
        "todo": {
          "id": "todo_kyoto",
          "asked_at": "2026-11-10T09:00:00Z",
          "recommend": "Ryokan Hanami",
          "options": [
            "Ryokan Hanami",
            "Kaede",
            "Tsuki"
          ],
          "responses": [
            "decide_yourself",
            "not_what_i_asked",
            "explain_first"
          ]
        }
      },
      "expected": {
        "category": "TODO_DECIDE",
