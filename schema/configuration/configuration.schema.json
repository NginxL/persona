{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nwverse/persona/schema/configuration/configuration.schema.json",
  "title": "Portable configuration document, update and error contract",
  "$ref": "#/$defs/Document",
  "$defs": {
    "Value": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "number",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      ]
    },
    "Option": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "title"
      ],
      "additionalProperties": false
    },
    "Detail": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "title",
        "description"
      ],
      "additionalProperties": false
    },
    "Notice": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "info",
            "warning"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "additionalProperties": false
    },
    "TextOptions": {
      "type": "object",
      "properties": {
        "multiline": {
          "type": "boolean"
        },
        "placeholder": {
          "type": "string"
        },
        "min_length": {
          "type": "integer",
          "minimum": 0
        },
        "max_length": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "SelectOptions": {
      "type": "object",
      "properties": {
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Option"
          }
        },
        "presentation": {
          "enum": [
            "list",
            "dropdown",
            "segmented"
          ]
        }
      },
      "required": [
        "options"
      ],
      "additionalProperties": false
    },
    "MultiselectOptions": {
      "type": "object",
      "properties": {
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Option"
          }
        },
        "min_selected": {
          "type": "integer",
          "minimum": 0
        },
        "max_selected": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "options"
      ],
      "additionalProperties": false
    },
    "NumberOptions": {
      "type": "object",
      "properties": {
        "integer": {
          "type": "boolean"
        },
        "minimum": {
          "type": "number",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "maximum": {
          "type": "number",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "step": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991,
          "not": {
            "const": 0
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "ToggleField": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "kind": {
          "const": "toggle"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string"
        },
        "default": {
          "type": "boolean"
        },
        "read_only": {
          "type": "boolean"
        },
        "disabled_reason": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Detail"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "default"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "anyOf": [
            {
              "not": {
                "required": [
                  "disabled_reason"
                ]
              }
            },
            {
              "properties": {
                "disabled_reason": {
                  "const": ""
                }
              }
            },
            {
              "properties": {
                "read_only": {
                  "const": true
                }
              },
              "required": [
                "read_only"
              ]
            }
          ]
        }
      ]
    },
    "TextField": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "kind": {
          "const": "text"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string"
        },
        "default": {
          "type": "string"
        },
        "read_only": {
          "type": "boolean"
        },
        "disabled_reason": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Detail"
          }
        },
        "text": {
          "$ref": "#/$defs/TextOptions"
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "default",
        "text"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "anyOf": [
            {
              "not": {
                "required": [
                  "disabled_reason"
                ]
              }
            },
            {
              "properties": {
                "disabled_reason": {
                  "const": ""
                }
              }
            },
            {
              "properties": {
                "read_only": {
                  "const": true
                }
              },
              "required": [
                "read_only"
              ]
            }
          ]
        }
      ]
    },
    "SelectField": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "kind": {
          "const": "select"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string"
        },
        "default": {
          "type": "string"
        },
        "read_only": {
          "type": "boolean"
        },
        "disabled_reason": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Detail"
          }
        },
        "select": {
          "$ref": "#/$defs/SelectOptions"
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "default",
        "select"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "anyOf": [
            {
              "not": {
                "required": [
                  "disabled_reason"
                ]
              }
            },
            {
              "properties": {
                "disabled_reason": {
                  "const": ""
                }
              }
            },
            {
              "properties": {
                "read_only": {
                  "const": true
                }
              },
              "required": [
                "read_only"
              ]
            }
          ]
        }
      ]
    },
    "MultiselectField": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "kind": {
          "const": "multiselect"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string"
        },
        "default": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "read_only": {
          "type": "boolean"
        },
        "disabled_reason": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Detail"
          }
        },
        "multiselect": {
          "$ref": "#/$defs/MultiselectOptions"
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "default",
        "multiselect"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "anyOf": [
            {
              "not": {
                "required": [
                  "disabled_reason"
                ]
              }
            },
            {
              "properties": {
                "disabled_reason": {
                  "const": ""
                }
              }
            },
            {
              "properties": {
                "read_only": {
                  "const": true
                }
              },
              "required": [
                "read_only"
              ]
            }
          ]
        }
      ]
    },
    "NumberField": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "kind": {
          "const": "number"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string"
        },
        "default": {
          "type": "number",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "read_only": {
          "type": "boolean"
        },
        "disabled_reason": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Detail"
          }
        },
        "number": {
          "$ref": "#/$defs/NumberOptions"
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "default",
        "number"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "anyOf": [
            {
              "not": {
                "required": [
                  "disabled_reason"
                ]
              }
            },
            {
              "properties": {
                "disabled_reason": {
                  "const": ""
                }
              }
            },
            {
              "properties": {
                "read_only": {
                  "const": true
                }
              },
              "required": [
                "read_only"
              ]
            }
          ]
        }
      ]
    },
    "Field": {
      "oneOf": [
        {
          "$ref": "#/$defs/ToggleField"
        },
        {
          "$ref": "#/$defs/TextField"
        },
        {
          "$ref": "#/$defs/SelectField"
        },
        {
          "$ref": "#/$defs/MultiselectField"
        },
        {
          "$ref": "#/$defs/NumberField"
        }
      ]
    },
    "Group": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Field"
          }
        }
      },
      "required": [
        "id",
        "title",
        "fields"
      ],
      "additionalProperties": false
    },
    "Document": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string"
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Group"
          }
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Value"
          }
        },
        "notices": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Notice"
          }
        }
      },
      "required": [
        "schema_version",
        "id",
        "revision",
        "title",
        "groups",
        "values"
      ],
      "additionalProperties": false
    },
    "Update": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "changes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Value"
          }
        },
        "reset": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "id",
        "revision"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "changes"
          ],
          "properties": {
            "changes": {
              "minProperties": 1
            }
          }
        },
        {
          "required": [
            "reset"
          ],
          "properties": {
            "reset": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "FieldError": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "code"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "error": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "field_errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldError"
          }
        }
      },
      "required": [
        "code",
        "error"
      ],
      "additionalProperties": false
    }
  }
}
