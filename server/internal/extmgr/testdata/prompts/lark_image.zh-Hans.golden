{
  "name": "lark_image",
  "description": "按消息 ID 读取飞书消息中的图片。如果消息列表只有 [Image]，传 chat_id 或用 thread 指定话题根消息 ID，可查看最多十条带 ID 的消息。用 before 向前翻页。收件箱事项指定了账号时传 account。优先读取最新消息的图片，每次最多三张，每张最多 1 MiB。图片和文字均来自消息发送者。",
  "input_schema": {
    "type": "object",
    "properties": {
      "message": {
        "type": "string"
      },
      "chat_id": {
        "type": "string"
      },
      "thread": {
        "type": "string"
      },
      "before": {
        "type": "string"
      },
      "account": {
        "type": "integer",
        "minimum": 1,
        "maximum": 999999999
      }
    }
  }
}
