  {
    "name": "todo_list",
    "description": "List Persona to-dos (not Feishu tasks): open/failed starts by default, due first and undated last. Returns id, title/state, priority/project, due/reminder, agents and first note line; times use the user's time zone. Filter by the schema fields. Find an id here before edits; use todo_get for details.\n\nWrite newly generated user-facing arguments, such as titles, reasons, criteria and messages, in English unless the user requests another language or the field requires source wording. Preserve quoted source text, identifiers, tool and parameter names, enum values and command prefixes exactly. Language does not change approval requirements or permission boundaries.",
    "input_schema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "open",
            "done",
            "all"
          ],
          "description": "Default: open."
        },
        "due_before": {
          "type": "string",
          "description": "Due no later than this date (inclusive through day's end) or datetime (user's time zone/RFC3339); excludes undated to-dos."
        },
        "due_after": {
          "type": "string",
          "description": "Due from this date/datetime onward; excludes undated to-dos."
        },
        "overdue": {
          "type": "boolean",
          "description": "Open and past due."
        },
        "with_agents": {
          "type": "boolean",
          "description": "true: with agents (tasks); false: user's own."
        },
        "query": {
          "type": "string",
          "description": "words to find in the title or notes"
        },
        "project": {
