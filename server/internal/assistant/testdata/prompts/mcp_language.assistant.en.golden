          "enum": [
            "short",
            "long"
          ]
        },
        "project_mode": {
          "type": "string",
          "enum": [
            "full",
            "reference-only"
          ],
          "description": "user-directed"
        },
        "source_urls": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "user-directed; replace; empty list clears"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "paused",
            "done"
          ]
        },
        "goal": {
          "type": "string"
        },
