{
  "name": "todo_list",
  "description": "List Persona to-dos (not Feishu tasks): open/failed starts by default, due first and undated last. Returns id, title/state, priority/project, due/reminder, agents and first note line; times use the user's time zone. Filter by the schema fields. Find an id here before edits; use todo_get for details.",
  "input_schema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "open",
          "done",
          "all"
        ],
        "description": "Default: open."
      },
      "due_before": {
        "type": "string",
        "description": "Due no later than this date (inclusive through day's end) or datetime (user's time zone/RFC3339); excludes undated to-dos."
      },
      "due_after": {
        "type": "string",
        "description": "Due from this date/datetime onward; excludes undated to-dos."
      },
      "overdue": {
        "type": "boolean",
        "description": "Open and past due."
      },
      "with_agents": {
        "type": "boolean",
        "description": "true: with agents (tasks); false: user's own."
      },
      "query": {
        "type": "string",
        "description": "words to find in the title or notes"
      },
      "project": {
        "type": "string",
        "description": "Existing knowledge-base project slug/name."
      },
      "kind": {
        "type": "string",
        "enum": [
          "todo",
          "concern"
        ],
        "description": "todo or user-raised concerns awaiting concern_report; omitted includes both."
      },
      "limit": {
        "type": "integer",
        "description": "Default 50; maximum 200."
      }
    }
  }
}
