{
  "name": "conversation_send",
  "description": "Message another conversation. It waits for a running turn or 2 min of user quiet. Marked as from this one; replies use conversation_send. Few hops per user message (main: no cap; a wake-up resets; a first reply adds none); long back-and-forth is cut. Past the rate it queues: the result says when, no resend. Don't reply just to acknowledge. Follow policy refusals; don't retry. Owner-verbatim words to main stay allowed: start with them. Handing on a user request: set quote (free once).",
  "input_schema": {
    "type": "object",
    "required": [
      "id",
      "text"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "full id or its first 8 characters"
      },
      "text": {
        "type": "string"
      },
      "quote": {
        "type": "string",
        "description": "\"latest\" or a message id: the user's words, carried verbatim"
      }
    }
  }
}
