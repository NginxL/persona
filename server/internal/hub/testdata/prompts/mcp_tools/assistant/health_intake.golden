{
  "name": "health_intake",
  "description": "Health chats only. log kind/amount (water ml, protein g); list entries/IDs, daily totals/goals (default 7 days incl. today); delete record UUID, repeatable. Estimates need ask_user; new ID per log; list before retrying.",
  "input_schema": {
    "type": "object",
    "required": [
      "action"
    ],
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "log",
          "list",
          "delete"
        ]
      },
      "kind": {
        "type": "string",
        "enum": [
          "water",
          "protein"
        ]
      },
      "amount": {
        "type": "number",
        "description": "ml 1-3000; g \u003e0-200; max one decimal."
      },
      "at": {
        "type": "string",
        "description": "RFC3339; default now."
      },
      "note": {
        "type": "string",
        "description": "Food/portion; max 4096 UTF-8 bytes; no NUL."
      },
      "days": {
        "type": "integer",
        "minimum": 1,
        "maximum": 366
      },
      "id": {
        "type": "string"
      }
    },
    "additionalProperties": false
  }
}
