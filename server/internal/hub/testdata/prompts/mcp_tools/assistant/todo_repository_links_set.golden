{
  "name": "todo_repository_links_set",
  "description": "Set saved-source links. [] clears; absent/empty titles keep. Reread conflicts. Metadata only.",
  "input_schema": {
    "type": "object",
    "required": [
      "id",
      "repo_id",
      "expected_revision",
      "links"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "repo_id": {
        "type": "string"
      },
      "expected_revision": {
        "type": "integer",
        "minimum": 0
      },
      "links": {
        "type": "array",
        "maxItems": 50,
        "items": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "enum": [
                "issue",
                "pull_request"
              ]
            },
            "number": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "title": {
              "type": "string",
              "description": "Plain source title; trim; ≤1024 UTF-8 bytes.",
              "maxLength": 1024
            },
            "role": {
              "type": "string",
              "description": "delivery (default): this task's own deliverable, verified by the delivery gate; reference: related work, shown but never verified at acceptance.",
              "enum": [
                "delivery",
                "reference"
              ]
            }
          },
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "url"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "kind"
                    ]
                  },
                  {
                    "required": [
                      "number"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "kind",
                "number"
              ],
              "not": {
                "required": [
                  "url"
                ]
              }
            }
          ]
        }
      }
    },
    "additionalProperties": false
  }
}
