{
  "name": "agent_supervise",
  "description": "Main only: adopt an Agent opened manually or by agent_start without a task. Creates a to-do/card, supervision signals and task_review closeout, as task_plan does. The background supervisor reviews it unless assistant.main_supervises_own_tasks is on; the answer names the supervisor, and main can still review. Already your task: done_when/expect_minutes change its brief scope (prefer task_scope). Another conversation's task stays theirs; use agent_transfer to move it.",
  "input_schema": {
    "type": "object",
    "required": [
      "machine",
      "session_id"
    ],
    "properties": {
      "machine": {
        "type": "string",
        "description": "agents_list machine id or name"
      },
      "session_id": {
        "type": "string",
        "description": "Agent session id or first 8 characters"
      },
      "title": {
        "type": "string",
        "description": "Chinese task title, under 20 characters; empty: Agent title"
      },
      "done_when": {
        "type": "array",
        "maxItems": 6,
        "items": {
          "type": "string"
        },
        "description": "checkable completion criteria"
      },
      "expect_minutes": {
        "type": "integer",
        "description": "estimated minutes from now"
      }
    }
  }
}
