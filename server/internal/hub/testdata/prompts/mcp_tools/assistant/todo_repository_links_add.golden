{
  "name": "todo_repository_links_add",
  "description": "Atomically add 1–50 exact issue/PR URLs across links:[{url,title}] and legacy urls, at least one in total. Auto-group even unlisted repositories; no manual entry. Actual titles only: nonempty refreshes, omitted/empty keeps. Deduplicate; explicit adds can restore removed links. Preserve aliases, refs and source snapshots. Replace/remove via todo_repositories_get and revision-checked set tools. Associations never prove completion.",
  "input_schema": {
    "type": "object",
    "required": [
      "id"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "urls": {
        "type": "array",
        "minItems": 1,
        "maxItems": 50,
        "items": {
          "type": "string"
        }
      },
      "links": {
        "type": "array",
        "maxItems": 50,
        "items": {
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string"
            },
            "title": {
              "type": "string",
              "description": "Plain source title; trim; ≤1024 UTF-8 bytes.",
              "maxLength": 1024
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  }
}
