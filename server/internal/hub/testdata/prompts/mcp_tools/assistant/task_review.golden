{
  "name": "task_review",
  "description": "accepted closes work after the delivery gate (default delivery_gate=merged: park verified open PRs; linked issues must close). user_check keeps the task and Agent open until owner Pass and routes feedback to that Agent. If opted in at Start, accepted done cleans up the idle tab unless user_check. Report closed/skipped/pending; never close the tab yourself. rework caps stalled/low-ROI churn at 2 rounds (external_input/substantive_new cap at 10 total); accept with a brief note instead of bouncing for low-ROI edge cases or style nitpicks. Replace stopped Agents via agent_start. Use parked with evidence for external waits and needs_user for owner decisions.\n\naccepted (outcome=done) with done_when needs every criterion once in checks (met=true + nonblank evidence); user_check cannot bypass. outcome=cannot, cancelled and no-criteria tasks are unchanged. Other verdicts may omit checks without losing progress. Report each criterion met/not_met/dropped, then also_done. Judge the scoped brief, not a handover or Agent claims.\n\nGive accepted's outcome/reason/link. The hub handles conclusion cards and passes “Please verify” on acceptance unless user_check. needs_user can default to recommend at 24h/deadline; irreversible or visible_to_others only reminds. Recheck at 24h. can_wait needs low cost, nobody blocked today and no deadline within 12h. “You decide”, “This isn't what I asked for” and “Tell me the background first” return to supervision. Clarify without repeating or taking irreversible/external action.\n\nA non-main conversation reviewing another supervisor's task may only accept/cancel; send gaps with agent_send. A leader's needs_user reaches main too. Cancel only duplicates/unwanted tasks; their Agents close/archive and waiting cards end.",
  "input_schema": {
    "type": "object",
    "required": [
      "todo_id",
      "verdict"
    ],
    "properties": {
      "todo_id": {
        "type": "string",
        "description": "the task's todo id (todo_…), from the 督办 message or the context snapshot"
      },
      "verdict": {
        "type": "string",
        "enum": [
          "accepted",
          "rework",
          "needs_user",
          "parked",
          "cancelled"
        ]
      },
      "rework_kind": {
        "type": "string",
        "enum": [
          "external_input",
          "substantive_new",
          "repeated_error",
          "low_roi_edge"
        ],
        "description": "rework, optional: external_input (external review/conflict/owner input; skips 2-round stalled cap), substantive_new (prior gap fixed, new defect found; resets stalled cap), repeated_error/low_roi_edge (default when omitted; cap 2 stalled, 10 total)"
      },
      "checks": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "criterion",
            "met"
          ],
          "properties": {
            "criterion": {
              "type": "string",
              "description": "one done_when criterion (or what the task was for, when it had none)"
            },
            "met": {
              "type": "boolean"
            },
            "evidence": {
              "type": "string",
              "description": "what shows it is met (a link, a command's output), or what is missing"
            }
          }
        },
        "description": "each criterion, met or not, with its evidence or gap; updates that done_when entry's persisted state, evidence, time and supervisor identity. Omitted entries keep their progress"
      },
      "note": {
        "type": "string",
        "description": "rework: what the agent is to do (Chinese, concrete); needs_user: what the user is to decide; parked: anything more than reason, for your own record; cancelled: why; accepted: the result in a line"
      },
      "outcome": {
        "type": "string",
        "enum": [
          "done",
          "cannot"
        ],
        "description": "accepted: done (the work is done or the answer is yes), or cannot (the task found it cannot be done); default done"
      },
      "reason": {
        "type": "string",
        "description": "accepted: the conclusion card's one sentence of why, in the user's language; default the note's first line. needs_user (required): one sentence saying what is to be decided, in the user's language. parked (required): one sentence saying what the task waits for, in the user's language; waiting on a PR: include its link"
      },
      "waiting_on": {
        "type": "string",
        "enum": [
          "someone_else",
          "external_event",
          "date"
        ],
        "description": "parked (required): someone_else (person acts/answers), external_event (outside event), or date. Owner decisions use needs_user; legacy owner_priority parks stay readable"
      },
      "until": {
        "type": "string",
        "description": "parked, optional: duration (\"3d\", \"36h\", \"90m\") or RFC 3339 time, 1m–30d ahead; default 24h. waiting_on=date requires explicit RFC 3339"
      },
      "link": {
        "type": "string",
        "description": "accepted/needs_user: one evidence link (PR/page/doc); defaults to task PR, note/checks link, or agent chat"
      },
      "recommend": {
        "type": "string",
        "description": "needs_user (required): recommended option label (first in options); owner OK sends it to the agent"
      },
      "why_owner": {
        "type": "string",
        "enum": [
          "irreversible",
          "visible_to_others",
          "priority",
          "acceptance",
          "only_owner_knows"
        ],
        "description": "needs_user (required): irreversible (delete/prod write/spend), visible_to_others (external message/comment/review), priority (whether/order), acceptance (visual check), only_owner_knows (private fact); decide anything else yourself"
      },
      "options": {
        "type": "array",
        "minItems": 2,
        "maxItems": 4,
        "items": {
          "type": "object",
          "required": [
            "label",
            "leads_to"
          ],
          "properties": {
            "label": {
              "type": "string",
              "description": "the option in a few words, as a button says it"
            },
            "leads_to": {
              "type": "string",
              "description": "one sentence: what choosing it leads to"
            }
          }
        },
        "description": "needs_user (required): 2 to 4 options the user chooses from, the recommended one first"
      },
      "cost_of_waiting": {
        "type": "string",
        "description": "needs_user (required): one sentence saying what it costs if the user does not answer soon"
      },
      "question_quote": {
        "type": "string",
        "description": "needs_user: quote the Agent's original question verbatim if reason paraphrases it, so the hub can check for an existing reply"
      },
      "can_wait": {
        "type": "boolean",
        "description": "needs_user, optional: defer to next daily briefing (no deadline \u003c12h, low cost_of_waiting); no push/card, listed in Needs you. Ignored for irreversible/visible_to_others, deadline \u003c12h, reversible=false, or no briefing with facts due within 24h and \u003e=12h before deadline; default false"
      },
      "deadline": {
        "type": "string",
        "description": "needs_user, optional: until when the decision waits, a duration (\"4h\", \"90m\") or an RFC 3339 time, 1 minute to 30 days ahead; needs reversible. Default: 24h and reversible, except for why_owner irreversible and visible_to_others, which have none"
      },
      "also_done": {
        "type": "array",
        "maxItems": 6,
        "items": {
          "type": "string"
        },
        "description": "accepted, optional: what was done beyond the task's brief (one line each); the task's page lists it after the criteria"
      },
      "user_check": {
        "type": "boolean",
        "description": "accepted only: the user is still to look at the result themselves (a UI change someone has to see): a \"Please verify\" card waits for their \"Pass\" instead of your acceptance passing it; default false"
      },
      "reversible": {
        "type": "boolean",
        "description": "with deadline: whether taking recommend can be undone later. false for deleting, sending anything to other people, spending money or changing production: those are never taken by default (why_owner irreversible and visible_to_others must say false)"
      },
      "evidence": {
        "type": "object",
        "required": [
          "kind",
          "target",
          "wake"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "person_reply",
              "merge_review",
              "external_event",
              "date"
            ],
            "description": "External wait kind"
          },
          "target": {
            "type": "string",
            "maxLength": 200,
            "description": "The person or external object"
          },
          "wake": {
            "type": "string",
            "maxLength": 600,
            "description": "Observable change that ends the wait"
          },
          "url": {
            "type": "string",
            "maxLength": 2000,
            "description": "Required for merge_review (ready PR/MR) and external_event"
          },
          "interaction_id": {
            "type": "string",
            "maxLength": 200,
            "description": "external_event only. This worker's exact pending owner request ID from agents_list. Shows the existing request"
          },
          "pr_event": {
            "type": "string",
            "enum": [
              "terminal",
              "terminal_or_review"
            ],
            "description": "GitHub PR waits only. terminal for merge or close. terminal_or_review adds new submitted reviews"
          },
          "contact": {
            "type": "object",
            "required": [
              "channel",
              "url",
              "sender",
              "sent_at",
              "request",
              "status"
            ],
            "properties": {
              "channel": {
                "type": "string",
                "maxLength": 100
              },
              "url": {
                "type": "string",
                "maxLength": 2000,
                "description": "sent-message/receipt link, not a channel homepage"
              },
              "sender": {
                "type": "string",
                "maxLength": 200
              },
              "sent_at": {
                "type": "string",
                "format": "date-time",
                "description": "actual sent time; not in the future"
              },
              "request": {
                "type": "string",
                "maxLength": 600
              },
              "status": {
                "type": "string",
                "enum": [
                  "sent"
                ]
              }
            },
            "description": "Sent request, required for person_reply and merge_review"
          },
          "ready": {
            "type": "boolean",
            "enum": [
              true
            ],
            "description": "merge_review only. The PR/MR is ready for the reviewer"
          },
          "reply": {
            "type": "object",
            "required": [
              "source",
              "brand",
              "app_id",
              "account_open_id",
              "person_open_id",
              "chat_id",
              "thread_id",
              "request_message_id"
            ],
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "larkcli"
                ]
              },
              "brand": {
                "type": "string",
                "enum": [
                  "feishu",
                  "lark"
                ]
              },
              "app_id": {
                "type": "string"
              },
              "account_open_id": {
                "type": "string"
              },
              "person_open_id": {
                "type": "string",
                "description": "expected human OpenID in this app, not self"
              },
              "chat_id": {
                "type": "string"
              },
              "thread_id": {
                "type": "string",
                "description": "provider topic ID, not root-message ID"
              },
              "request_message_id": {
                "type": "string"
              }
            },
            "description": "person_reply: exact IDs from a configured lark-cli reader, never names. contact.url must be the sent request's matching topic AppLink. A verified reply asks the current supervisor to review, not direct Agent delivery"
          }
        },
        "description": "Required for parked. Inspect the source. recorded_by is output only. Missing legacy evidence is unverified"
      }
    }
  }
}
