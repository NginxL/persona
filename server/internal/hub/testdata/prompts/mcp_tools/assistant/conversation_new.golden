{
  "name": "conversation_new",
  "description": "Open a Persona conversation with a first message; returns its id. For threads the user asks for. Marked as from this one; named after its first turn and told to report with conversation_send. Failure or no report leaves one notice. A read-only policy may refuse: follow it, do not retry. Add `tags` only if asked.",
  "input_schema": {
    "type": "object",
    "required": [
      "text"
    ],
    "properties": {
      "text": {
        "type": "string",
        "description": "everything the new conversation needs; it does not see this one"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "initial tags; trimmed and de-duplicated, at most 10 of 32 characters each"
      },
      "quote": {
        "type": "string",
        "description": "\"latest\" or a message id: the user's words, carried verbatim"
      }
    }
  }
}
