[
  {
    "name": "mail_accounts",
    "description": "List the mail accounts the user has configured (name, address, provider). Call this before searching or sending mail so you know which account_id to use.",
    "input_schema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "mail_search",
    "description": "Search mail. Returns message summaries (uid, subject, from, date, snippet). Use account_id from mail_accounts; omit it to search every account's inbox at once. For Gmail the query uses Gmail search syntax (from:, subject:, has:attachment, newer_than:7d); other providers search the full text on their server. Some servers do not search at all (NetEase 163 finds nothing for any word): when the server finds nothing, subjects, senders and recipients are matched instead (every word must appear, case does not matter; bodies are not searched), a stretch of the newest mail at a time, and the result says which before_uid looks further back.",
    "input_schema": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string",
          "description": "Account id from mail_accounts; omit to search all inboxes"
        },
        "mailbox": {
          "type": "string",
          "description": "Mailbox name, default INBOX"
        },
        "query": {
          "type": "string",
          "description": "Search text or Gmail query"
        },
        "limit": {
          "type": "integer",
          "description": "Max results, default 20, max 200"
        },
        "before_uid": {
          "type": "integer",
          "description": "Return messages with UID lower than this, for paging"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "mail_read",
    "description": "Read one message in full: headers, plain text, HTML and the attachment list (each with its id for mail_save_attachment). Does not mark the message as read.",
    "input_schema": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string"
        },
        "uid": {
          "type": "integer"
        },
        "mailbox": {
          "type": "string",
          "description": "Mailbox name, default INBOX"
        }
      },
      "required": [
        "account_id",
        "uid"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "mail_save_attachment",
    "description": "Save one attachment of a message (a PDF, CSV, xlsx, zip…) as a file on this computer, the one you run on, and return its path. The id is the one mail_read lists after the attachment. Files go under the Persona data directory's attachments/mail folder, in the subfolder dir if given; an existing file is never overwritten (the new one gets a numbered name). At most 25 MB. Does not mark the message as read. Read, unzip or move the saved file with your own tools afterwards.",
    "input_schema": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string"
        },
        "uid": {
          "type": "integer"
        },
        "mailbox": {
          "type": "string",
          "description": "Mailbox name, default INBOX"
        },
        "attachment_id": {
          "type": "string",
          "description": "The id mail_read lists after the attachment"
        },
        "dir": {
          "type": "string",
          "description": "Subfolder to save into, relative (e.g. bills/2026-10); no absolute paths, '..' or hidden folders"
        }
      },
      "required": [
        "account_id",
        "uid",
        "attachment_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "mail_send",
    "description": "Send an email from one of the user's accounts. The user must approve each send on their phone before it goes out, so fill in a clear subject and body. To reply, pass in_reply_to with the original Message-ID and references with the original References chain plus that Message-ID.",
    "input_schema": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string"
        },
        "to": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/address"
          }
        },
        "cc": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/address"
          }
        },
        "bcc": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/address"
          }
        },
        "subject": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "description": "Plain-text body"
        },
        "html": {
          "type": "string",
          "description": "Optional HTML body"
        },
        "in_reply_to": {
          "type": "string",
          "description": "Message-ID being replied to"
        },
        "references": {
          "type": "string",
          "description": "Space-separated Message-IDs from the original thread"
        }
      },
      "required": [
        "account_id",
        "to",
        "subject",
        "text"
      ],
      "$defs": {
        "address": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string"
            }
          },
          "required": [
            "email"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "ask_user",
    "description": "Ask the user one or more multiple-choice questions on their iPhone (a card in this conversation plus a push notification) and wait for the answers. Use it to confirm anything risky (sending messages / email for them, deleting, changing live systems) or to let them pick between options. AskUserQuestion does not work here; use this. They can also type a free-form answer. Waits up to 2 hours; if the user writes in this conversation instead of picking an option, the question is withdrawn and the tool returns at once, with their message following. If nobody answers in time, the question becomes a to-do that waits for the user's call (in their to-do list and the next briefing), and their answer comes to this conversation later as a new message. With a deadline (each question then recommends one of its options): if nobody answers by it and you marked it reversible, the recommended options are taken by default and recorded on the question's to-do; one that cannot be undone is only reminded again and keeps waiting. With wait false the card goes up the same way but the call returns at once: end the turn without guessing the answer; it comes later as a new message quoting the question and the answer (or saying the card was closed unanswered, or expired and became a to-do). Use wait false only where your instructions say to; a confirmation this same turn needs (approving a message before it is sent) keeps the default. A waiting call holds this turn, so anything else sent to this conversation waits behind it: once such a message waits and the question has been up for a couple of minutes, the call returns without the answer and the card stays up as with wait false; end the turn then.",
    "input_schema": {
      "type": "object",
      "required": [
        "questions"
      ],
      "properties": {
        "wait": {
          "type": "boolean",
          "description": "default true: hold this turn until the user answers. false: put the card up and return at once; the answer arrives later as a new message in this conversation"
        },
        "deadline": {
          "type": "string",
          "description": "optional: until when the questions wait, a duration (\"30m\", \"4h\") or an RFC 3339 time, 1 minute to 30 days ahead; needs reversible and a recommend on every question"
        },
        "reversible": {
          "type": "boolean",
          "description": "with deadline: whether going ahead with the recommended options can be undone later. false for deleting, sending anything to other people, spending money or changing production: those are never taken by default"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "question",
              "options"
            ],
            "properties": {
              "question": {
                "type": "string"
              },
              "header": {
                "type": "string",
                "description": "short label, ≤12 chars"
              },
              "multiSelect": {
                "type": "boolean"
              },
              "recommend": {
                "type": "string",
                "description": "the label of the option you recommend; required with deadline"
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "required": [
                    "label"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  {
    "name": "notify_user",
    "description": "Send the user a push notification right now (works when the app is closed). Tapping it opens this conversation. Use for results of scheduled runs and anything time-sensitive; ordinary replies already notify. In the hub's low-distraction mode, a notice from a conversation other than the main one is held for the briefing instead of alerting unless it is P0; the tool answer then says it was moved to the briefing, so treat the user as not alerted.",
    "input_schema": {
      "type": "object",
      "required": [
        "title",
        "body"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "push_level": {
          "type": "string",
          "enum": [
            "P0",
            "P1"
          ],
          "description": "How urgent this is. P1 (default): worth knowing; in the hub's low-distraction mode it is held for the briefing instead of alerting, and from a non-main conversation it is held even without an explicit level. P0: something the user must do or decide themselves (an action only they can take, a decision only they can make), so it alerts even in low-distraction mode and from any conversation. Use P1 for results, progress and conclusions."
        },
        "related_key": {
          "type": "string",
          "description": "Optional: what this is about, such as a PR link or a to-do id. In low-distraction mode the same key interrupts at most once in 12 hours, and held notices about it are listed together."
        }
      }
    }
  },
  {
    "name": "supervision_finish",
    "description": "Finish handling a supervision wake-up without cluttering the user's main conversation. Use visibility=\"silent\" when no user decision or useful result needs to be shown, with a short summary of what you checked or changed; then end the turn. The complete turn stays available in the expandable supervision record. Use visibility=\"user\" to explicitly show the turn without sending a notification. notify_user, ask_user, and task_review user conclusion cards also promote the turn. A promoted turn cannot be made silent again. This tool is only for supervision-triggered turns, not normal user messages.",
    "input_schema": {
      "type": "object",
      "required": [
        "visibility",
        "summary"
      ],
      "properties": {
        "visibility": {
          "type": "string",
          "enum": [
            "silent",
            "user"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "schedule_followup",
    "description": "Wake yourself later with `prompt`; `new_conversation: true` uses its own chat. Wakes reset the message hop chain at most once per 10 minutes. `at` accepts RFC3339 or relative 30m/2h/1d. For repeats set `every` (5m-7d) once; never chain runs. Or use `cron` instead of at/every: 5 fields in the user's zone, at least 5m apart; @hourly/@daily/@weekly/@monthly/@yearly work. Day 0/7 is Sunday; restricted day fields match either. Inspect the reply's next runs. `until` cannot be a bare clock time.\n\nRuns inherit Main chat's launcher/model/effort; overrides require an own conversation, and permission mode stays the user's choice. `inbox` is only for requested Inbox results. `fresh_each_run: true` starts a new chat each run with its state note. See field descriptions for push and end-time edit rules.\n\nFor approved recurring work advancing a supervised to-do, pass its explicit `todo_id`; do not guess from a title. Omission keeps an association; \"\" clears it; one-shots refuse it. Progress means new Agent answers, criterion-state changes or changed explicit progress reports. One no-progress run signals the supervisor; two ask Change approach / Keep waiting with the reason, even with `push: asked`. Get owner consent before creating or changing recurring work.",
    "input_schema": {
      "type": "object",
      "required": [
        "prompt"
      ],
      "properties": {
        "todo_id": {
          "type": "string",
          "description": "explicit supervised to-do this recurring follow-up advances; empty clears the association"
        },
        "fresh_each_run": {
          "type": "boolean"
        },
        "at": {
          "type": "string",
          "description": "when (the first run, with every); default with every: one interval from now"
        },
        "every": {
          "type": "string",
          "description": "repeat this often, e.g. 30m"
        },
        "cron": {
          "type": "string",
          "description": "repeat on a cron expression instead of at / every: minute hour day-of-month month day-of-week in the user's time zone, e.g. */30 9-18 * * 1-5"
        },
        "prompt": {
          "type": "string",
          "description": "what to do then, self-contained"
        },
        "title": {
          "type": "string",
          "description": "short label shown in the app"
        },
        "new_conversation": {
          "type": "boolean",
          "description": "start a fresh conversation instead of continuing this one"
        },
        "push": {
          "type": "string",
          "enum": [
            "every",
            "asked"
          ],
          "description": "every (default for a new task): each run's answer is pushed to the user; asked: only what a run sends with notify_user, for a task that watches something or a standing loop (a patrol, a daily round). Continuing this conversation, a run's answer is then not pushed or sent to channels; from Main chat it runs in its own conversation instead. Omit to keep an existing task's"
        },
        "inbox": {
          "type": "string",
          "enum": [
            "off",
            "worthy",
            "every"
          ],
          "description": "what of a run goes into the user's Inbox, independent of push: off (default for a new task), worthy (a run puts a row there with inbox_post only when it finds something worth a look), every (every run ends with a row made by Persona). Set it only when the user asked for it. Omit to keep an existing task's"
        },
        "until": {
          "type": [
            "string",
            "null"
          ],
          "description": "optional end time (RFC 3339 or 30m / 2h / 1d). After it, Persona turns the task off and records a skipped run instead of running. Omit to keep an existing task's end time; null clears it. Ignored for a one-off."
        },
        "launcher": {
          "type": "string",
          "description": "this task's own launcher, instead of Main chat's (a name on the computer where its runs start). Needs new_conversation: true: a follow-up that continues this conversation runs on that conversation's launcher. Empty clears the override and follows Main chat again. Omit to keep an existing task's"
        },
        "model": {
          "type": "string",
          "description": "model id for the launcher above; without a launcher it pins the launcher the task runs on now. Empty uses the launcher's default. Omit to keep an existing task's"
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "description": "thinking effort for Claude launchers; without a launcher it pins the launcher the task runs on now. Omit to keep an existing task's; empty clears it"
        }
      }
    }
  },
  {
    "name": "schedule_routine",
    "description": "Create a recurring routine, or pass `id` from list_followups to edit only the fields supplied. `enabled: false` pauses it. Use `time` with optional `weekdays`, or `cron` instead. Times use the user's zone; cron has 5 fields, runs at least 5m apart, supports the listed aliases, treats 0/7 as Sunday and restricted day fields as either. Seconds, @every and TZ= are refused; inspect the reply's next runs. `until` cannot be a bare clock time.\n\nRuns inherit Main chat's launcher/model/effort. Omit overrides to keep them; an empty launcher returns to Main chat. Permission mode stays the user's choice. `inbox` is only for requested Inbox results. `fresh_each_run: true` starts a new chat per run with its state note. See field descriptions for push and end-time edit rules.\n\nFor approved work advancing a supervised to-do, pass its explicit `todo_id`; this conversation must supervise it. Omission keeps its association; \"\" clears it. Persona checks Agent answers, criterion-state changes and changed explicit progress reports. One no-progress run signals the supervisor; two ask Change approach / Keep waiting with the reason, even with `push: asked`. Get owner consent before creating or changing recurring work.",
    "input_schema": {
      "type": "object",
      "properties": {
        "todo_id": {
          "type": "string",
          "description": "explicit supervised to-do this routine advances; empty clears the association"
        },
        "fresh_each_run": {
          "type": "boolean"
        },
        "id": {
          "type": "string",
          "description": "to change an existing routine"
        },
        "title": {
          "type": "string",
          "description": "short name shown in the app, e.g. 早报"
        },
        "prompt": {
          "type": "string",
          "description": "what to do each time, self-contained"
        },
        "time": {
          "type": "string",
          "description": "HH:MM, 24-hour"
        },
        "weekdays": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "description": "1 = Monday … 7 = Sunday; omit or empty = every day"
        },
        "cron": {
          "type": "string",
          "description": "instead of time / weekdays: minute hour day-of-month month day-of-week in the user's time zone, e.g. */30 9-18 * * 1-5 or 0 10 1 * *; or @hourly / @daily / @weekly / @monthly / @yearly"
        },
        "enabled": {
          "type": "boolean"
        },
        "report": {
          "type": "boolean",
          "description": "a daily report (such as a leader conversation's): each run opens with Persona's north-star lines (today's interruptions and availability, the change against yesterday until the same time, the source), which the report starts with. Omit to keep an existing routine's"
        },
        "push": {
          "type": "string",
          "enum": [
            "every",
            "asked"
          ],
          "description": "every (default for a new task): each run's answer is pushed to the user; asked: only what a run sends with notify_user, for a task that watches something (it then runs in its own conversation). Omit to keep an existing task's"
        },
        "inbox": {
          "type": "string",
          "enum": [
            "off",
            "worthy",
            "every"
          ],
          "description": "what of a run goes into the user's Inbox, independent of push: off (default for a new task), worthy (a run puts a row there with inbox_post only when it finds something worth a look; for a task that watches something), every (every run ends with a row made by Persona; for a briefing the user follows daily). Set it only when the user asked for it. Omit to keep an existing task's"
        },
        "run_if": {
          "type": [
            "object",
            "null"
          ],
          "description": "Optional owner-approved shell check on the routine computer before scheduled runs. Exit 0 runs; exit 1 skips. Other errors follow on_error. Omit to keep it or use null to remove it.",
          "properties": {
            "command": {
              "type": "string",
              "maxLength": 4096
            },
            "timeout_s": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60,
              "default": 30
            },
            "on_error": {
              "type": "string",
              "enum": [
                "run",
                "skip"
              ],
              "default": "run"
            }
          },
          "required": [
            "command"
          ],
          "additionalProperties": false
        },
        "until": {
          "type": [
            "string",
            "null"
          ],
          "description": "optional end time (RFC 3339 or 30m / 2h / 1d). After it, Persona turns the task off and records a skipped run instead of running. Omit to keep an existing task's end time; null clears it. Ignored for a one-off."
        },
        "launcher": {
          "type": "string",
          "description": "this routine's own launcher, instead of Main chat's (a name on the computer where its runs start). Empty clears the override and follows Main chat again. Omit to keep an existing routine's"
        },
        "model": {
          "type": "string",
          "description": "model id for the launcher above; without a launcher it pins the launcher the routine runs on now. Empty uses the launcher's default. Omit to keep an existing routine's"
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "description": "thinking effort for Claude launchers; without a launcher it pins the launcher the routine runs on now. Omit to keep an existing routine's; empty clears it"
        }
      }
    }
  },
  {
    "name": "schedule_state_set",
    "description": "Stage the recurring task's state note for this scheduled run. Call near the end of the run with the run key in the scheduled prompt and the full replacement state (up to 4096 UTF-8 bytes). Keep cursors, references, and what was already reported. The hub attempts to save the draft after confirming that the run succeeded. If it cannot track the run or write the note, later runs use the last saved note. An empty string clears the note when saved.",
    "input_schema": {
      "type": "object",
      "required": [
        "run_key",
        "text"
      ],
      "properties": {
        "run_key": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "delete_routine",
    "description": "Delete a scheduled task (routine or follow-up) by id (from list_followups). Confirm with the user first unless they asked for it.",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "list_followups",
    "description": "List every scheduled task (with ids): follow-ups that have not run yet, repeating ones, daily routines. A repeating task with an end time shows that time.",
    "input_schema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "cancel_followup",
    "description": "Cancel a scheduled follow-up or a repeating task by id (from list_followups).",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "list_places",
    "description": "The user's saved places (home, the office, …) with their coordinates and reminder radius, as the user set them in Settings › Assistant › Saved Places or as you saved them with save_place. Read them before a reminder by place, and before a route or directions to or from a place the user names (home, the office); never take a place's coordinates from memory.",
    "input_schema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "save_place",
    "description": "Save a place to the user's saved places, or change the saved place of the same name. Only for a place the user just confirmed in this conversation (their current location while they are there, or a phone_location_search result they picked); the user sees and edits it in Settings › Assistant › Saved Places.",
    "input_schema": {
      "type": "object",
      "required": [
        "name",
        "latitude",
        "longitude"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "What the user calls it, e.g. 家 or 公司 (at most 40 characters)"
        },
        "address": {
          "type": "string",
          "description": "The address, as phone_location_search gave it"
        },
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "radius_meters": {
          "type": "integer",
          "description": "The reminder circle, 100–2000; leave it out for 150"
        }
      }
    }
  },
  {
    "name": "machines_list",
    "description": "List computers' connection, system, resources, agents, launcher failures and node builds. Samples over 30 seconds old are stale. Nulls have reasons; do not infer or rank.",
    "input_schema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "machine_redeploy",
    "description": "Redeploy by ID or exact name; return the confirmed outcome.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine"
      ],
      "properties": {
        "machine": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "agents_list",
    "description": "The Claude Code / Codex agents running on the user's computers (herdr), with their state: needs_you (waiting for an answer / approval), working, unread (finished, result not looked at), idle. done lists work finished in the last 24 hours, and muted lists the muted agents that would otherwise appear in the live snapshot; both include the work conclusion when known. Each line has machine, session id, project, title, last update and the last thing the agent said. launcher= names the launcher an agent runs on when it is known, and usage_limit (with resets_at when the reset is known) marks one its subscription's usage limit stopped (agent_switch moves such an agent to another launcher when the user asks). Known Claude Code switch states appear as ultracode=on/off; an omitted state is unknown. ultracode=on means every substantive task runs a multi-agent dynamic workflow, independently of thinking effort. Let it finish and wait for workflow results without nudging it. Much faster and more accurate than ssh + herdr. At the end: the launchers that failed their last health check, by machine (agent_start and task_plan move off them).\n\nA line under an agent is something waiting for the user: a question lists its options and the interaction id to answer it with (interaction_answer), an approval is the user's to give in the app.",
    "input_schema": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "active",
            "needs_you",
            "working",
            "unread",
            "idle",
            "done",
            "muted",
            "archived",
            "all"
          ],
          "description": "default active = needs_you + working + unread; done = finished work in the last 24 hours; muted = muted agents in the live snapshot categories; archived: only the archived sessions (agent_unarchive restores them); the others leave archived ones out, all lists them marked archived"
        },
        "machine": {
          "type": "string"
        },
        "query": {
          "type": "string",
          "description": "filter by title / project / directory"
        }
      }
    }
  },
  {
    "name": "agent_read",
    "description": "Read the recent conversation of one agent (from agents_list): the user's messages, what the agent said, tool calls in short form. `turns` = how many recent exchanges (default 2, max 10). Use it to answer the user's follow-ups about work an agent or task already did (its conclusion, a PR link, why it stopped) instead of asking the agent with agent_send, which makes it take another turn while the user waits (and a stopped agent takes no messages: it is read-only).",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "session_id"
      ],
      "properties": {
        "machine": {
          "type": "string"
        },
        "session_id": {
          "type": "string",
          "description": "full id or its first 8 characters"
        },
        "turns": {
          "type": "integer"
        }
      }
    }
  },
  {
    "name": "agent_send",
    "description": "Send a message to an agent as the user would type it; queued while it works. Only send what the user asked for. A stopped agent takes no plain message. Only a recorded non-user stop (idle, task completion, restart) permits resume; user and unknown stops need the user's Resume. If the next work needs its context (investigation followed by a fix, rework, the user asked for this agent), send with resume and resume_why: the same session and permission mode, your text first, the reason shown to the user. It must be supervised (give task unless it is on an open task of yours). A nearly full one is compacted first. Unrelated work or one off track: agent_start anew (agent_read the old). Unsure: ask_user. A failed resume says why. A user's branch that never ran is started by its first message. Only /exit or /quit stops a running agent (tab kept); finished tasks' agents stop automatically. /exit to another conversation's task is refused (the user can close it, or agent_archive with close).\n\nA dialog holding its terminal refuses the send (dialog_open) with its first line and whether Enter alone closes it; then send with dismiss_notice true. Confirmations, permissions and pickers are never closed for you: tell the user or use interaction_answer.\n\nTo hand new work to a running agent (one the user opened, a long-lived one that passes work on), give task from the main conversation: once sent, the agent is your supervised task as agent_supervise makes one (a todo with the text as notes, done_when, a card; 督办 messages, task_review). Put the criteria in the text too: the agent reads only the text. An agent on one of your tasks takes more under the same title (done_when updated); another title, the user's own todo or another conversation's task is refused, with nothing sent. A failed send makes no task. Leave task out or null for a reply, nudge or decision; a task with only blank fields counts as left out.\n\n`wait_seconds` observes up to 50 seconds after dispatch, appending `Inline observation` JSON: `completed`(this input's `reply`), `question`(pending `interaction_id`), `timeout`/`cancelled`/`unavailable`/`interrupted`/`failed`, with known input/session ids. Observation never answers questions, accepts tasks, resends or cancels work; normal supervision/`task_review` applies. Older nodes may time out rather than return an unrelated reply.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "session_id",
        "text"
      ],
      "properties": {
        "wait_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "0/omitted: normal receipt"
        },
        "machine": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "resume": {
          "type": "boolean",
          "description": "resume this stopped agent with its context, text as its first message"
        },
        "resume_why": {
          "type": "string",
          "description": "shown to the user"
        },
        "dismiss_notice": {
          "type": "boolean",
          "description": "Press Enter first to close a notice that only says \"Enter to continue\" (no options). Any other dialog still refuses the send."
        },
        "attachments": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          },
          "description": "absolute paths of pictures/files the user gave in this conversation (Claude Code path or app attachment); copied to the agent, appended to its message with mentions updated; others refused"
        },
        "task": {
          "type": [
            "object",
            "null"
          ],
          "description": "new work: make it your supervised task first (main conversation only); null for a reply",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "description": "the task in a short line (Chinese, under 20 characters)"
            },
            "done_when": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "type": "string"
              },
              "description": "results you can check when it says it is done (a PR merged, a sheet's link, what the live system answers)"
            },
            "expect_minutes": {
              "type": "integer",
              "description": "how long it should take from now; longer without progress counts as stuck"
            }
          }
        }
      }
    }
  },
  {
    "name": "agent_switch",
    "description": "Move a running Claude Code agent (from agents_list) to another launcher on its computer and go on with it, in one step: the agent is quit and resumed on that launcher in the same terminal, with the same conversation, and `text` is sent to it there. It is the switch the user makes from the agent's chat. Use it only when the user asked for it, for example when a subscription's usage limit stopped agents and the user wants them to go on with another provider now rather than wait for the reset; never on your own. The launcher must be one of that computer's (machines_list and agents_list show the names). The switch happens now or not at all: an agent that is working, waits for the user (a question, a permission, a plan), is starting, has background work its quit would end, or has a draft or a dialog in its input box is refused with nothing typed and nothing left waiting; tell the user why, and try again once it has stopped if they still want it. Other refusals say why too (a launcher that does not run there or is not signed in, a model the launcher's default cannot be read for: give model). Not for stopped agents (agent_send with resume), assistant conversations, read-only agents, or Codex and other agents. An agent its usage limit stopped goes on with what it was doing when `text` is left out; any other agent needs `text`. Its usage-limit continuation, if one was due, is not sent afterwards.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "session_id",
        "launcher"
      ],
      "properties": {
        "machine": {
          "type": "string",
          "description": "the machine's id or name, as agents_list shows it"
        },
        "session_id": {
          "type": "string",
          "description": "the agent's session id, or its first 8 characters"
        },
        "launcher": {
          "type": "string",
          "description": "the launcher to move it to, by its name on that computer"
        },
        "model": {
          "type": "string",
          "description": "a model of that launcher; empty: the launcher's default"
        },
        "effort": {
          "type": "string",
          "description": "the reasoning effort on the new launcher; empty: as it is"
        },
        "text": {
          "type": "string",
          "description": "what the agent does on the new launcher, sent as the user would type it; empty only for an agent its usage limit stopped (it goes on with what it was doing)"
        }
      }
    }
  },
  {
    "name": "agents_switch",
    "description": "Move many Claude Code agents to another launcher on their computers in one call. Use it when the user asks to move agents to another launcher (\"move everything on the default launcher to X\", \"switch these to X\"), for example because they watch their subscription quota; never on your own. Name the agents in `agents`, or leave it out to take every Claude Code agent (running ones, and stopped ones Persona started), narrowed by `machine` and `from_launcher` (`claude` is the default launcher). First call it with `preview` true and tell the user what it will do with each agent, then call it again without `preview` once they agree; when the user already named exactly which agents and where, one call is enough. Each agent goes as its state allows: one its usage limit stopped is switched now and goes on with what it was doing; an idle one is switched now and nothing is sent (it waits on the new launcher for the next message); one that is working, waits for the user (a question, a permission, a plan), is starting or has background work is queued and switched when its turn ends (with the usage-limit continuation if that turn ended on a limit); a stopped one Persona started has the launcher it resumes on changed, so its next Resume, or the message that resumes it, comes up on the new launcher; one the checks refuse (another CLI, a runtime's session, an assistant conversation, a launcher that does not run there, a model the launcher's default cannot be read for: give model) is reported and left as it is, and so is one whose switch failed on its computer (it is back on its launcher; not tried again: tell the user why). The answer has one line per agent: switched and continued, switched, switched (takes effect when resumed), queued, or refused with why. A queued switch is dropped if the agent moves to another launcher meanwhile or after a day; if it stops meanwhile, its Resume is pointed at the new launcher instead; agents_list shows queued ones as switch_queued=. The switch is the same as the user's from the agent's chat: same conversation, same terminal.",
    "input_schema": {
      "type": "object",
      "required": [
        "launcher"
      ],
      "properties": {
        "launcher": {
          "type": "string",
          "description": "the launcher to move them to, by its name on their computers"
        },
        "model": {
          "type": "string",
          "description": "a model of that launcher; empty: the launcher's default"
        },
        "effort": {
          "type": "string",
          "description": "the reasoning effort on the new launcher; empty: as each has it"
        },
        "agents": {
          "type": "array",
          "description": "the agents to move; empty: every Claude Code agent (running, or stopped and started by Persona) that machine and from_launcher keep",
          "items": {
            "type": "object",
            "required": [
              "session_id"
            ],
            "properties": {
              "machine": {
                "type": "string",
                "description": "the machine's id or name, as agents_list shows it"
              },
              "session_id": {
                "type": "string",
                "description": "the agent's session id, or its first 8 characters"
              }
            }
          }
        },
        "machine": {
          "type": "string",
          "description": "without agents: only this computer's agents"
        },
        "from_launcher": {
          "type": "string",
          "description": "without agents: only the agents running on this launcher (claude: the default)"
        },
        "preview": {
          "type": "boolean",
          "description": "true: only say what it would do with each agent; nothing is switched or queued"
        }
      }
    }
  },
  {
    "name": "agent_interrupt",
    "description": "Stop what an agent (from agents_list) is doing right now, and optionally redirect it: its current turn is cut off (Esc in its terminal, or its runtime's cancel), the agent and its session stay, and `then` is sent to it at once as the user would type it. Use it when waiting is worse than stopping: it works in the wrong direction, waits in a loop (sleep, polling), repeats a failing step, collides with another agent, or the user said stop. To add a word to an agent that works fine, use agent_send instead (queued behind its turn). What it did already is not undone (files it changed, commands it ran): tell it in `then` what to put back. Not for assistant conversations, and not for agents that can only be read. A `then` of only /exit or /quit to an agent on a task another conversation supervises is refused, as agent_send refuses it: nothing is stopped or sent.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "session_id"
      ],
      "properties": {
        "machine": {
          "type": "string",
          "description": "the machine's id or name, as agents_list shows it"
        },
        "session_id": {
          "type": "string",
          "description": "the agent's session id, or its first 8 characters"
        },
        "then": {
          "type": "string",
          "description": "the new instruction, sent right after it stopped; empty: just stop it"
        }
      }
    }
  },
  {
    "name": "agent_start",
    "description": "Start a new agent in the terminal engine (herdr or Orca) of one of the user's computers, in a project directory, with a first prompt. Use for real development work instead of doing it here. Check machines_list before choosing a machine. Returns the new session id. When the launcher failed its last health check on that machine, the agent starts on a machine where it works (a directory under the home moves to that home) and the answer says so. Claude-family launchers and Paseo providers with Auto Accept always start in bypassPermissions; traex and omp: no effort.\n\nThe launcher decides the agent. A Claude Code launcher starts Claude Code. A launcher named pi, cursor or agy (or one the machine lists as that agent) starts that agent in a herdr pane with the model you give: pi, the Cursor CLI (cursor-agent) or the Antigravity CLI (agy). pi's first message goes through its Persona extension; cursor's and agy's go through herdr once it recognises the agent. Those three take no permission mode and no ultracode, and their effort is their own.\n\nWhen the work needs a branch and checkout of its own (work in parallel with what is already open in that repository), give `worktree.branch`: Persona makes the worktree through the machine's engine first (herdr's or Orca's own, so it is listed there and in the app, under the workspace `cwd` is in) and starts the agent in it. Do not tell the agent to run `git worktree add` itself: a worktree made that way is invisible to Orca and to the app. An existing local branch is checked out; a new one starts at the HEAD of the workspace `cwd` is in. A branch already checked out elsewhere is refused.\n\nWhen the agent needs credentials the user keeps in a secret provider (a token in 1Password, say), give `secret_env`: each environment variable it should have, with the reference its value comes from (such as `op://vault/item/field`), never the secret itself. The user approves the hand-off on a card on iPhone or the web before anything starts, and the values reach only that agent's environment, for this run: you never see them, and the answer lists each variable as granted, declined, expired or failed. Only Claude Code agents on a computer this manager connects take them. Tell the agent the variables exist; never ask it to print them.\n\nGive `ultracode: true` for a large task: one that spans many files or needs checking from several angles (design, tests, review). Claude Code then runs every substantial step as a multi-agent workflow: slower and costlier: off for small work. Do not write the word \"ultracode\" into the prompt instead. Claude Code agents only (2.1.284 or later): any other agent, an older Claude Code or a node too old for it starts without it, and the answer says so. Once Claude Code confirms it, agents_list shows `ultracode=on`. An organization policy may keep some conversations read-only: a call from such a conversation is refused with the policy's reason. Do not retry; follow the refusal.\n\n`wait_seconds` observes up to 50 seconds after dispatch, appending `Inline observation` JSON: `completed`(this input's `reply`), `question`(pending `interaction_id`), `timeout`/`cancelled`/`unavailable`/`interrupted`/`failed`, with known input/session ids. Observation never answers questions, accepts tasks, resends or cancels work; normal supervision/`task_review` applies. Older nodes may time out rather than return an unrelated reply.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "cwd",
        "prompt"
      ],
      "properties": {
        "wait_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "0/omitted: normal receipt"
        },
        "machine": {
          "type": "string"
        },
        "cwd": {
          "type": "string",
          "description": "absolute path or ~/…; with worktree, a directory of the repository to branch from"
        },
        "prompt": {
          "type": "string"
        },
        "attachments": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          },
          "description": "absolute paths of pictures/files the user gave in this conversation (Claude Code path or app attachment); copied to the agent, appended to its message with mentions updated; others refused"
        },
        "launcher": {
          "type": "string",
          "description": "listed launcher (Claude Code, pi, cursor or agy); unknown names refused with choices; empty: default/fallback, claude first, answer says which"
        },
        "secret_env": {
          "type": "object",
          "maxProperties": 8,
          "additionalProperties": {
            "type": "string"
          },
          "description": "NAME → secret-provider reference (op://vault/item/field), never a value; card approval first"
        },
        "ultracode": {
          "type": "boolean",
          "description": "Claude Code multi-agent workflows for substantial steps; default false"
        },
        "worktree": {
          "type": "object",
          "description": "engine-made worktree of cwd's repository",
          "required": [
            "branch"
          ],
          "properties": {
            "branch": {
              "type": "string",
              "description": "the branch to check out (made from the workspace's HEAD when it does not exist)"
            }
          }
        },
        "tier": {
          "type": "string",
          "description": "Agent preset from the snapshot's 模型档位 line; choose by purpose; resolved before approval and shown on the card; explicit launcher/model/effort/speed overrides"
        },
        "speed": {
          "type": "string",
          "enum": [
            "standard",
            "fast",
            "ultrafast"
          ],
          "description": "new-start speed; explicit choice overrides the tier. standard/omitted: launcher default. Codex: fast, ultrafast; Claude Code: fast only"
        },
        "effort": {
          "type": "string",
          "description": "Explicit effort; omit for tier/purpose default."
        },
        "model": {
          "type": "string",
          "description": "Explicit model id or alias the agent takes; omit for the tier or purpose default."
        }
      }
    }
  },
  {
    "name": "agent_supervise",
    "description": "Main only: adopt an Agent opened manually or by agent_start without a task. Creates a to-do/card, supervision signals and task_review closeout, as task_plan does. The background supervisor reviews it unless assistant.main_supervises_own_tasks is on; the answer names the supervisor, and main can still review. Already your task: done_when/expect_minutes change its brief scope (prefer task_scope). Another conversation's task stays theirs; use agent_transfer to move it.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "session_id"
      ],
      "properties": {
        "machine": {
          "type": "string",
          "description": "agents_list machine id or name"
        },
        "session_id": {
          "type": "string",
          "description": "Agent session id or first 8 characters"
        },
        "title": {
          "type": "string",
          "description": "Chinese task title, under 20 characters; empty: Agent title"
        },
        "done_when": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string"
          },
          "description": "checkable completion criteria"
        },
        "expect_minutes": {
          "type": "integer",
          "description": "estimated minutes from now"
        }
      }
    }
  },
  {
    "name": "agent_transfer",
    "description": "Main only: move an open Agent task to a current direction or main (App Move to). Keep task, brief, criteria, estimate, origin and Agent; no message, interruption or restart. Transfer back to undo. Refuses user-owned to-dos, assistant sessions and untracked work (adopt with agent_supervise).",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "session_id",
        "supervisor"
      ],
      "properties": {
        "machine": {
          "type": "string",
          "description": "agents_list machine id or name"
        },
        "session_id": {
          "type": "string",
          "description": "Agent session id or first 8 characters"
        },
        "supervisor": {
          "type": "string",
          "description": "exact direction or main id from conversations_list"
        }
      }
    }
  },
  {
    "name": "agent_archive",
    "description": "Archive a coding agent's session (from agents_list) when the user asks to archive or tidy up agents: it leaves the Agents list for Archived in the app, nothing is deleted, and agent_unarchive brings it back (never remove a session any other way). Persona also asks the agent's own tool to archive it where that tool has an archive (Codex); the result says whether it did (native: done / pending / unsupported). Without close the agent itself is not closed: one open on its computer stays open. With close, its agent and its terminal tab are also closed on its computer (its transcript stays; then it is stopped until resumed): only when the user asks to close it too, and the user confirms on the phone first (declined: nothing changes). A busy agent is refused and nothing changes: working, waiting for an answer or background work, and for close also a /loop, queued messages or a server it runs. When the close does not happen the session stays archived and still open on the computer, and the result says why: tell the user exactly that, not that it was closed. With `force: true`, explicitly cancel and close an Agent stuck waiting for a terminal confirmation, then archive it, as `paseo archive --force` does. Use force only when the user asks to stop or archive that blocked Agent. Pending permissions and plans are rejected or cancelled, never allowed. Working Agents, background work, running subagents/workflows, queued messages, loops and serving ports are still refused. A failed close leaves it visible. Force implies close and does not ask for a second permission card. Not for Persona conversations (conversation_archive).",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "session_id"
      ],
      "properties": {
        "machine": {
          "type": "string",
          "description": "the machine's id or name, as agents_list shows it"
        },
        "session_id": {
          "type": "string",
          "description": "the agent's session id, or its first 8 characters"
        },
        "force": {
          "type": "boolean",
          "description": "cancel and close a confirmation-blocked Agent before archiving; only when the user asks; never approve its pending request"
        },
        "close": {
          "type": "boolean",
          "description": "also close its agent on the computer (asks the user on the phone first); default false: archive only"
        }
      }
    }
  },
  {
    "name": "agent_unarchive",
    "description": "Bring an archived coding agent's session back into the Agents list (find it with agents_list and state archived). Nothing is reopened on the computer: a stopped agent stays stopped until resumed (agent_send with resume). Persona also asks the agent's own tool to restore it where that tool archived it too; the result says whether it did.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "session_id"
      ],
      "properties": {
        "machine": {
          "type": "string",
          "description": "the machine's id or name, as agents_list shows it"
        },
        "session_id": {
          "type": "string",
          "description": "the agent's session id, or its first 8 characters"
        }
      }
    }
  },
  {
    "name": "agent_autoname",
    "description": "Rename one coding agent's session with the model when the user explicitly asks for Auto Rename. This replaces the current title, including a hand-written one, with a short title generated from its conversation; it does not change the terminal tab's title. The user must confirm this write on the phone every time; a declined or unanswered confirmation does nothing and makes no model call. The background automatic-naming switch and its once-only/placeholder restrictions do not block this explicit request. Do not use it on Persona conversations (including the main chat), on an agent the user has not asked to rename, or with a session-id prefix. Use the exact machine and session_id from agents_list. On success the JSON answer has title, title_source: auto and changed; on refusal it has the stable code and retryable fields. The HTTP endpoint used by client menus is separate and does not depend on this tool.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machine",
        "session_id"
      ],
      "properties": {
        "machine": {
          "type": "string",
          "description": "the machine's exact id or name, as agents_list shows it"
        },
        "session_id": {
          "type": "string",
          "description": "the agent's exact full session id, never a prefix"
        }
      }
    }
  },
  {
    "name": "agent_autoname_receipt",
    "description": "Read-only: inspect the current assistant's existing agent_autoname confirmation cards and one coding agent's current naming snapshot. This does not prove that a particular earlier model call started, completed or succeeded: the model's tool-call id is not a manager-side correlation. The naming snapshot may predate the call or come from another caller, and background naming failures are not attributed to it. Do not retry a request from this result; unknown or ambiguous means the evidence cannot settle the outcome. Use only the exact machine and full session id from agents_list. The caller is verified from the actual assistant conversation; no other assistant's cards can be read. Optional since/before are an RFC3339 window of at most 24 hours, and must be supplied together. Confirmation history is read with bounded pages; incomplete pages are reported. This tool never calls the naming model, writes settings, approves or resolves a card, renames an agent, or publishes a session list. Not for Persona conversations, ordinary coding Agents, or extensions.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machine",
        "session_id"
      ],
      "properties": {
        "machine": {
          "type": "string",
          "description": "the machine's exact id, as agents_list shows it"
        },
        "session_id": {
          "type": "string",
          "description": "the agent's exact full session id, never a prefix"
        },
        "since": {
          "type": "string",
          "format": "date-time",
          "description": "inclusive RFC3339 start of the original confirmation window; requires before"
        },
        "before": {
          "type": "string",
          "format": "date-time",
          "description": "exclusive RFC3339 end of the original confirmation window [since,before); at most 24 hours after since"
        }
      }
    }
  },
  {
    "name": "interaction_answer",
    "description": "Answer another agent's question for the user, in their place, when they said what to answer or told you to decide. Only a question can be answered this way: a tool permission, a plan and a terminal dialog are theirs to decide in the app, and the assistant's own question is never answered by itself. Every question must be answered by its own wording, with the option labels it offers; free text is not accepted (the user answers that in the app, or you use agent_send). A multi-select takes an array of labels. A card a 督办 message handed you before the user (a task you supervise) is yours to answer when it is the agent's own call: give reason, and the answer is kept as the task's decision; what the user must decide goes to them with ask_escalate.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "session_id",
        "interaction_id",
        "answers"
      ],
      "properties": {
        "machine": {
          "type": "string",
          "description": "the machine's id or name, as agents_list shows it"
        },
        "session_id": {
          "type": "string",
          "description": "the agent's session id, or its first 8 characters"
        },
        "interaction_id": {
          "type": "string",
          "description": "the waiting interaction's id, from agents_list"
        },
        "answers": {
          "type": "object",
          "description": "each question's own wording → the option label to pick; a multi-select gives an array of labels",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "reason": {
          "type": "string",
          "description": "optional: in a sentence, why this answer (kept with the task's decision when a 督办 message handed you the card)"
        }
      }
    }
  },
  {
    "name": "ask_escalate",
    "description": "Hand the cards a task's agents wait on to the user, when a 督办 message gave them to you first and the user must decide: a tool permission or a plan (no conversation approves those), or a question that is irreversible, seen by other people, changes the goal or goes against a decision already made on the task. Every card of the task the user has not been told of goes to them at once, as one reminder (in the user's low-distraction mode it pushes only when why_owner or p0 says it is theirs alone), with your reason and recommendation on it; their answers go straight to the agents and are kept as the task's decisions. Only the task's supervisor and the main conversation can. A leader's escalation is told to the main conversation too, so don't ask the user the same thing again yourself.",
    "input_schema": {
      "type": "object",
      "required": [
        "todo_id",
        "reason"
      ],
      "properties": {
        "todo_id": {
          "type": "string",
          "description": "the task's todo id (todo_…), from the 督办 message"
        },
        "reason": {
          "type": "string",
          "description": "in a sentence, in the user's language: what they are to decide and why it is theirs"
        },
        "recommend": {
          "type": "string",
          "description": "the option you recommend, in a line (an option's label when there is one)"
        },
        "why_owner": {
          "type": "string",
          "enum": [
            "irreversible",
            "visible_to_others",
            "priority",
            "acceptance",
            "only_owner_knows"
          ],
          "description": "why only the user can decide it. In the user's low-distraction mode only irreversible, visible_to_others and only_owner_knows push to their phone; the rest wait in their Needs you list and briefing"
        },
        "p0": {
          "type": "boolean",
          "description": "true: the user must do or decide this themselves now, so it pushes even in low-distraction mode whatever why_owner says"
        }
      }
    }
  },
  {
    "name": "inbox_suggest",
    "description": "Submit the event’s recap and one suggestion, replacing any earlier suggestion. It waits in the user's inbox; nothing goes out until they confirm, and then the program does exactly what it says (you never send it yourself). `kind`: `reply` — one message to send, `text` in the user's voice, ready to go out as it is (no blanks to fill in like 【…】: leave out what you could not find and say so in `note`; for a Feishu sheet / Base item `changes` proposes moving rows' status: ref, field and one of the values the item lists); `agent` — an Agent to start, `text` its instruction (`machine` and `cwd` optional); `todo` — a to-do for the user to add: `text` its title (clear, starting with the action, no chat or people names), `due` only when the message states a deadline: a day `2006-01-02` for all day, or a moment as RFC 3339 with its offset; leave it out when unsure and say so in `note`; the user can edit both and adds it with one tap (a row that came to a to-do counts as handled); `conclusion` — you dealt with it, `text` the conclusion, `outcome` `fyi` (worth knowing) or `done` (nothing to do). `handback: true` for one the user has to judge: their confirmation comes back here as an instruction instead of being carried out. `note`: one or two sentences on what you found and where. `recap`: the event's background, progress and where it is stuck (up to 600 characters), every time. `title`: what the matter is, without chat or person names; `summary`: one sentence on where things stand and who is waited on for what. Write both every time; items whose title comes from the source (mail, documents, PRs / issues, and the like) ignore `title`, and the tool says so. `related`: ids of inbox items in other chats or sources this one is about. `recap` without `kind` creates no suggestion, and may include `title`, `summary`, and `follow`. `follow` records waiting on the other side: `who` (empty means waiting for a reply), `next`, and `check_at` (RFC 3339 with a time zone) or `check_in` (such as `30m`, `4h`, or `2d`). `check_at` takes precedence; with neither, look again in `24h`; the resulting time is clamped to 30 minutes–14 days from now. `follow` is valid only without `kind`. `reported`: `{text, by}` records one externally visible action you or an Agent actually completed but the program did not observe, without verifying it; never use it for plans or actions not taken. `by` is `agent` or `assistant` (default `assistant`), and `text` is one sentence, kept on one line and clipped to 120 characters. It may be given alone or accompany `kind`, `recap`, `title`, `summary`, or `follow`; a filed item refuses it, and text identical to the item's latest `reported` entry is not recorded twice. Call it at the end of each turn. In a conversation the user handed an inbox item to (its context block names the item's id), pass that id as `item` and call it when you have something to write back to the item, and again whenever it changes (it also shows in that conversation as a card); it refuses an item not handed to this conversation or one the user already filed: answer in the chat then.",
    "input_schema": {
      "type": "object",
      "properties": {
        "processing_turn": {
          "type": "string"
        },
        "item": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "reply",
            "agent",
            "conclusion",
            "todo"
          ]
        },
        "text": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "handback": {
          "type": "boolean"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "fyi",
            "done"
          ]
        },
        "recap": {
          "type": "string"
        },
        "reported": {
          "type": "object",
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "by": {
              "type": "string",
              "enum": [
                "agent",
                "assistant"
              ],
              "default": "assistant"
            }
          }
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "follow": {
          "type": "object",
          "properties": {
            "who": {
              "type": "string"
            },
            "next": {
              "type": "string"
            },
            "check_at": {
              "type": "string",
              "format": "date-time"
            },
            "check_in": {
              "type": "string"
            }
          }
        },
        "machine": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "due": {
          "type": "string"
        },
        "related": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ref",
              "field",
              "value"
            ],
            "properties": {
              "ref": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  {
    "name": "inbox_draft",
    "description": "Legacy inbox_suggest `reply`. Prefer inbox_suggest. Draft a reply for this conversation’s inbox item. It waits in the user's inbox; they read it and send it with one tap (you never send it yourself). `text` is the reply in the user's voice, ready to go out as it is: no blanks to fill in (【…】) — leave out what you could not find and say so in `note`; `note` is one or two sentences on what you found and where, for the user to check the draft against. For a Feishu sheet / Base item, `changes` proposes moving rows' status (ref, field and one of the values the item lists); they are made when the user sends. Call it once, at the end.",
    "input_schema": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "processing_turn": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ref",
              "field",
              "value"
            ],
            "properties": {
              "ref": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  {
    "name": "inbox_folders",
    "description": "List the folders the user's inbox items are filed under: each `/`-separated path (`work/alerts/engine`, every segment a level) with its item count and open count, and whether automatic filing by the triage model is on. Give `folder` to also list the items filed in that folder and below, or `unfiled: true` for the items in no folder; each line has the item's id (what inbox_move takes), source, title, sender and whether it is done. Call it before inbox_move, to reuse a folder in use rather than open a near-duplicate.",
    "input_schema": {
      "type": "object",
      "properties": {
        "folder": {
          "type": "string",
          "description": "a folder path: also list the items filed there and below"
        },
        "unfiled": {
          "type": "boolean",
          "description": "also list the items in no folder"
        }
      }
    }
  },
  {
    "name": "inbox_move",
    "description": "Move inbox items into a folder, as the user would from the inbox: `items` are their ids (from inbox_folders, or the id of an item handed to this conversation), `folder` a `/`-separated path (`work/alerts/engine`; a new path makes the folder), or `\"\"` to take them out of every folder. Moved items stay where they are put: the triage model no longer files them. An unknown id or a path with no name in it moves nothing. Move only what the user asked for.",
    "input_schema": {
      "type": "object",
      "required": [
        "items",
        "folder"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "inbox item ids"
        },
        "folder": {
          "type": "string",
          "description": "the folder path, or \"\" for no folder"
        }
      }
    }
  },
  {
    "name": "inbox_post",
    "description": "Put this conversation into the user's Inbox as a row that opens it, so a result is not missed behind a quiet unread dot. Call it only when the user explicitly asked for it (for example \"tell me if there is anything worth a look\", \"send me the briefing every time\") or when the scheduled task you are running is set to put findings in the Inbox. Never decide on your own to interrupt the user: an ordinary reply, a run with nothing new, or something merely interesting does not go there. `title` is a short name for the row (the task's name or what was found), `summary` one or two sentences saying what to look at, `tier` is `action` when the user has to do something and `fyi` (the default) when it is worth knowing, and `reason` names the request or task setting that makes this post (the user can read it on the row). Calling it again for this conversation soon after updates the same row instead of adding another. It does not push to the phone: use notify_user for that when the user asked for a push.",
    "input_schema": {
      "type": "object",
      "required": [
        "title",
        "summary",
        "reason"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "tier": {
          "type": "string",
          "enum": [
            "action",
            "fyi"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "kb_search",
    "description": "Search the knowledge base: summaries and metadata of chats, people, projects, docs, meetings, events, recordings (with their minutes and any transcript still retained), topics (curated knowledge points: how something works, what was decided and why, the steps and pitfalls), project timelines, the notes directories the user added (hits with an absolute path) and, with messages=true, the full message archive (newest days first). All words must match. Hits come in the order the files are read, not by relevance, so a broad search can fill the limit with chats: give kind to search one kind only, the entries whose name matches first, then as kb_list ranks them. A past meeting (its decisions, what is still open, who does what) is kind=recordings: found by its title, the calendar event's title, its minutes or any transcript still retained; then kb_get it. Transcripts expire before minutes: never promise a trimmed recording's full transcript.",
    "input_schema": {
      "type": "object",
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "projects",
            "chats",
            "people",
            "docs",
            "meetings",
            "events",
            "recordings",
            "topics"
          ],
          "description": "only this kind's entries (no notes directories; the message archive only with chats)"
        },
        "messages": {
          "type": "boolean",
          "description": "also search the message archive (default true)"
        },
        "limit": {
          "type": "integer",
          "description": "default 40"
        }
      }
    }
  },
  {
    "name": "kb_list",
    "description": "List knowledge-base entities of one kind ranked by importance (P0 first), relevance to the user, recency: projects (short = a feature / launch, long = a team mission), chats, people, docs, meetings, events, recordings (the user's phone / watch recordings; newest first, saying which have meeting minutes, which are all-day recordings with a day recap and its state, and which transcripts have expired), topics (knowledge points curated by subject out of the timelines and chats: concepts, decisions with their reasons, practices, pitfalls, facts, open questions; the biggest first). Transcripts stay for recording_days (14 days by default), minutes and recaps for minutes_days (forever by default). Meetings, events and recordings show when they started, in the user's time zone. Optional tag filter.",
    "input_schema": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "projects",
            "chats",
            "people",
            "docs",
            "meetings",
            "events",
            "recordings",
            "topics"
          ]
        },
        "tag": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "description": "default 30"
        }
      }
    }
  },
  {
    "name": "kb_get",
    "description": "Read one entity: its metadata (links to people / chats / projects, tags), compressed context (summary.md), a project's timeline, a chat's messages of the last 7 days, a recording's meeting minutes, or an all-day recording's day recap (the day's timeline, meetings, suggested to-dos), with each action item's state (suggested, or its to-do's) and its timestamped transcript while still retained (phone/watch recordings, text only), a meeting's / event's recordings, a topic's knowledge points by subtopic (each with its kind, reason and the entries it came from). Transcripts expire after recording_days (14 days by default); minutes and recaps stay for minutes_days (forever by default). id from kb_list / kb_search (a project also by name). A project lists its 20 most relevant people and a count (all: meta.json).",
    "input_schema": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "projects",
            "chats",
            "people",
            "docs",
            "meetings",
            "events",
            "recordings",
            "topics"
          ]
        },
        "id": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "kb_update",
    "description": "Write to the knowledge base: create or change a project (name, project_kind short|long, status, goal, my_role, aliases, link chats / people, code dirs as \"\u003cmachine\u003e:\u003cpath\u003e\" so Agents there belong to it, append a timeline `log` line, replace its summary), or tag / annotate a chat, person, doc, meeting, event, recording (a recording's content is the phone's: only its tags, pinned and projects; importance P0–P3, relevance 0–100, tags, note, link projects), or a topic (its points are curated: only its name, note, aliases and tags). Tags set here are kept over the automatic ones. `remove_*` (ids) unlink for good: Persona won't relink it by itself; the rest still updates. Use it whenever a conversation settles something about a project or person. Two projects that are the same work under two names: `merge_into`; two that were merged but are not: `unmerge` on the one merged away.",
    "input_schema": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "projects",
            "chats",
            "people",
            "docs",
            "meetings",
            "events",
            "recordings",
            "topics"
          ]
        },
        "id": {
          "type": "string",
          "description": "id, or a project's name (created when new)"
        },
        "merge_into": {
          "type": "string",
          "description": "projects only: fold this project into that one (slug or name); nothing else changes in the same call"
        },
        "unmerge": {
          "type": "boolean",
          "description": "projects only: undo the merge that folded this project (slug or name) into another; nothing else changes in the same call"
        },
        "name": {
          "type": "string"
        },
        "project_kind": {
          "type": "string",
          "enum": [
            "short",
            "long"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "paused",
            "done"
          ]
        },
        "goal": {
          "type": "string"
        },
        "my_role": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "importance": {
          "type": "string",
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "relevance": {
          "type": "integer"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string",
          "description": "Markdown, replaces summary.md"
        },
        "log": {
          "type": "string",
          "description": "one line appended to a project's timeline"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "remove_aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "projects: aliases that are not this project's (another's name, too generic)"
        },
        "chats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "remove_chats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "people": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "remove_people": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dirs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  {
    "name": "kb_history_plan",
    "description": "Show or change what a source's history import reads. What is read of each chat comes from the knowledge base's selection (the same rules as daily ingestion; per-chat settings are changed here with `set`): the whole chat, only the user's own messages (with the messages around them) and mentions of the user, or nothing. Without `set` or `back_days` it refreshes the source's chat list and lists the chats grouped that way, largest first, with each chat's id and any per-chat setting of the user's. `set` changes per-chat settings, which apply to daily ingestion too: a chat by its id or exact name (a name two chats share is refused with their ids, a name no chat has gets close names; then nothing is changed); `read: false` never reads it, `read: true, store: true` keeps the whole chat (for `days`, or as the rules say), `read: true, store: false` only the user's messages and mentions, `reset: true` back to the rules. `back_days` limits how far back the import goes (null: as far as the rules keep messages). A change, or a refreshed list, that reads more than the user approved takes the approval back, so the import needs kb_history_resume again; reading less does not. Listing or changing never starts the import: show the user the list, apply the exceptions they name, show the result again, and only when they say to start call kb_history_resume. Needs `kb.history.enabled` in manager.json.",
    "input_schema": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "description": "connector id from kb.history.sources; omitted: every configured source (required with set or back_days)"
        },
        "set": {
          "type": "array",
          "description": "per-chat settings to change, all or none",
          "items": {
            "type": "object",
            "required": [
              "chat"
            ],
            "properties": {
              "chat": {
                "type": "string",
                "description": "the chat's id, or its exact name"
              },
              "read": {
                "type": "boolean",
                "description": "false: never read it (required unless reset)"
              },
              "store": {
                "type": "boolean",
                "description": "true: keep the whole chat; false: only the user's messages and mentions"
              },
              "days": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "with store: how many days its lines are kept (null: as the rules say)"
              },
              "reset": {
                "type": "boolean",
                "description": "remove the chat's setting: the rules decide again"
              }
            }
          }
        },
        "back_days": {
          "type": [
            "integer",
            "null"
          ],
          "description": "how many days back the import goes for this source; null: as far as the rules keep messages"
        }
      }
    }
  },
  {
    "name": "kb_history_status",
    "description": "How the history import is doing, per source: its state (running, resting, paused, stopped, done, waiting for approval or for the search index), whether its plan is approved, chats done / to go / paused / in error / unreadable with messages read and written, calls and messages in the last hour, the last slowdown, pause and stop with their reasons, and the last call. Read-only.",
    "input_schema": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "description": "one connector id; omitted: all configured sources"
        }
      }
    }
  },
  {
    "name": "kb_history_stop",
    "description": "Stop the history import now: it makes no further call until the user resumes it (the call in flight, if any, finishes; nothing is cancelled). Use it whenever the user says to stop or pause importing history.",
    "input_schema": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "description": "why, in a few words, as the user said it; shown in the status, never written to the log"
        }
      }
    }
  },
  {
    "name": "kb_history_resume",
    "description": "Approve a source's history import plan, as the selection reads it now, and start or resume the import (it also clears a stop). Only when the user has seen the plan (kb_history_plan) and explicitly says to start or resume; never on your own. After a stop, check kb_history_status first and tell the user why it stopped; `slow` keeps the slowest pace for the first two hours after the import starts again, the safe choice after a stop.",
    "input_schema": {
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "description": "connector id from kb.history.sources"
        },
        "slow": {
          "type": "boolean",
          "description": "the slowest pace for the first two hours of calls"
        }
      }
    }
  },
  {
    "name": "persona_settings",
    "description": "Read and change Persona's own settings for the user: their inbox sorting rules, how their inbox items link to their tasks, 关于我 (what you know about them), your default launcher (model), their mail accounts, which Claude Code config directories each machine keeps out of Agents, and each extension's settings (extension.\u003cid\u003e: what Settings › Extensions shows, like turning one of its features on). Start with action list (what there is, what each takes); get reads one. set / add / remove put a card on the user's phone that says what changes (before → after) and nothing changes until they approve; what the card needs filled in, like a mail password, the user types there, so never ask for passwords in the conversation. Change only what the user asked for.\n\n`assistant.standing_authorizations`: get returns `{revision, authorizations}`. Only the main conversation may set the whole list, with its current revision and the user’s own approval on the phone. Each grant names one `machine_id`, a specific absolute `directory`, `actions` (merge, push, deploy-test, deploy-production, send, delete, spend), `conditions`, the user’s exact `quote`, `source`, and `reversible`. Keep existing grants unchanged by ID; to change a grant, remove it and add a new entry without an ID. The server assigns the new ID and grant time. Never invent a user quote or expand the scope. Conditions may retain the user’s words; only independently verifiable conditions can permit automatic answers. Revocation is available in Settings through the authorization list. Tool permissions are never automatically approved.",
    "input_schema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "list",
            "get",
            "set",
            "add",
            "remove"
          ],
          "description": "default list"
        },
        "key": {
          "type": "string",
          "description": "the setting, from list (inbox.rules, mail.accounts, extension.\u003cid\u003e…)"
        },
        "value": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "object",
            "array",
            "null"
          ],
          "description": "set: the new value; add: the item (each setting's list entry says what)"
        },
        "id": {
          "type": "string",
          "description": "remove: which item (from get)"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "secret_run",
    "description": "Run commands on one of the user's computers that need a password only the user knows, typically its sudo password. Never ask for a password in the conversation or in ask_user: call this instead. The user gets a card in the Persona app showing the computer, your purpose and every command verbatim, types the password there and taps Run; that computer's node then runs exactly those commands in order, each as the user with /bin/sh -c in the home directory and PATH=/usr/bin:/bin:/usr/sbin:/sbin (give other tools by their absolute path). Only a command that runs sudo with -S gets the password, as a line on its stdin; every other command gets an empty stdin. Write sudo as `sudo -S -k -p '' …`, one sudo per command and never after a pipe (sudo would read the pipe; run a pipeline as root with `sudo -S -k -p '' sh -c '…'`); a sudo without -S is refused. Where a sudoers rule says NOPASSWD, sudo does not read stdin and the command it runs gets the password instead, so do not give such a command anything that reads stdin. Commands are printable ASCII only, so the card shows exactly what runs. The first command that fails stops the run. Never write a command that prints, stores or sends the password; you never see it. The result is JSON with status (ran, failed, declined, expired or refused), the computer, a message and, for ran and failed, each command's exit_code, timed_out and output (stdout and stderr, clipped to its end); when a command's output held the password, none of it comes back (output_withheld: true). A command stopped at the timeout may still run as root: check before asking again. declined, expired and refused mean nothing ran: tell the user; ask again only if they want. Not on Windows.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "purpose",
        "commands"
      ],
      "properties": {
        "machine": {
          "type": "string",
          "description": "the computer to run on: its id or name, as agent_start takes it"
        },
        "purpose": {
          "type": "string",
          "description": "one sentence the card shows: why the password is needed"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 5,
          "description": "1 to 5 one-line shell commands of printable ASCII, at most 1000 characters each, run in order"
        },
        "delivery": {
          "type": "string",
          "enum": [
            "stdin"
          ],
          "description": "how the password reaches the commands: stdin, the default and only way"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800,
          "description": "for the whole run, default 300"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "skill_import",
    "description": "Import a user-requested skill ZIP through Persona's existing Settings importer. First preview the base64-encoded archive (up to 4 MiB compressed); returns validated metadata, a short-lived reference and environment. Then install with the same archive, reference and environment. Installation and undo wait for the user's own permission card showing the validated skill and target computer; never approve for the user. The target is the current assistant's configured personal computer, never a model-chosen path or machine. Skills are shared by assistants using that computer account and load in new conversations; an existing conversation is not guaranteed to refresh. Same-name skills are never overwritten. ZIP inspection does not run scripts or treat skill instructions as authorization. Use status with the original reference and environment after a lost/uncertain response, before any retry: it records previewed, installed or undone and recovers the undo receipt. Status is an operation receipt, not a live inventory; receipts expire after ten minutes or a computer restart. If unavailable, inspect Settings \u003e Skills instead of assuming failure. Cancel discards an unused preview. Undo takes an installed receipt, refuses edited/replaced files and retains recovery data. No URL download, repository clone, arbitrary path write or arbitrary skill removal is provided. An older computer may require a Persona update.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "preview",
            "install",
            "status",
            "cancel",
            "undo"
          ]
        },
        "archive": {
          "type": "string",
          "maxLength": 5592408,
          "description": "Base64 ZIP bytes, required only for preview and install. Supply identical bytes for both; do not put secrets in the archive."
        },
        "reference": {
          "type": "string",
          "maxLength": 256,
          "description": "Opaque receipt from preview/install, required except for preview. Never invent one."
        },
        "environment": {
          "type": "string",
          "maxLength": 128,
          "description": "Environment returned by preview, required except for preview. A changed assistant computer requires a fresh preview."
        }
      }
    }
  },
  {
    "name": "model_profiles_list",
    "description": "List editable model profiles, current profile, changed fields, rollback and recent audit events. Profiles contain model settings only, never credentials.",
    "input_schema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "model_profile_get",
    "description": "Inspect one model profile by id. See its purpose bindings, launcher model fields and named execution tiers (the Agent presets). Add, change or remove a tier with persona_settings key model_profiles.tiers; other fields are edited through the model-profiles HTTP API. Saving does not apply purpose or launcher settings.",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Profile id from model_profiles_list"
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    }
  },
  {
    "name": "model_profile_switch",
    "description": "Switch atomically to a model profile by id when the user asks (for example economy or performance). Saves a before-image for model_profile_rollback and records actor/time. Applies on next model call or Agent start; does not interrupt running work. Inspect profiles first; do not assume economy needs any particular model.",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Profile id from model_profiles_list"
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    }
  },
  {
    "name": "model_profile_rollback",
    "description": "Undo the last model-profile switch using its saved before-image. Restores only touched model settings, not launcher credentials. Inspect the rollback preview with model_profiles_list first; a second rollback redoes the switch.",
    "input_schema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "repositories_list",
    "description": "Search this assistant's saved repository references to resolve repository identity when a request is ambiguous. Search names, aliases, full repository paths and purposes; use repository_get for details only when useful. An explicit repository URL or path supplied by the user takes precedence. These bindings are references, not authorization or an allowlist; never infer a machine or local checkout path from a remote reference. Returns only saved metadata and verified_at, without remote checks, source fetching, cloning or permission checks. Non-repository tasks do not need a lookup. This guidance is not a mandatory dispatch preflight.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional case-insensitive substring of a saved name, alias, full path or purpose; omit to browse. Preserve explicit user repository choices."
        },
        "cursor": {
          "type": "string",
          "maxLength": 1024,
          "description": "Opaque next_cursor from this assistant's previous page with the same query. Restart without it if the saved references changed."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "Results per page, default 20; at most 50."
        }
      }
    }
  },
  {
    "name": "repository_get",
    "description": "Read one saved repository reference belonging to the current assistant, using its id from repositories_list. Returns provider, instance, full path, canonical URL, optional name/aliases/purpose and verified_at from saved metadata only. Use details only when useful to resolve repository context. An explicit repository URL or path supplied by the user takes precedence. A binding is a reference, not authorization or an allowlist; never infer a machine or local checkout path from it. Does not check the remote, read source, clone, expose credentials or establish permissions.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Stable saved binding id returned by this assistant's repositories_list, not a URL, machine, path or another assistant's id."
        }
      }
    }
  },
  {
    "name": "repository_add",
    "description": "Add a saved repository reference to the current assistant when the user asks. Accepts the same URLs and metadata as Settings \u003e Repositories, checks existence through the repository's provider, and refuses duplicates or concurrent changes. Shows the normalized repository and details in a permission card; only the user's own approval saves it. Returns the saved binding with id and verified_at. This is a reference, not authorization or an allowlist: it does not clone, fetch source, grant permissions, or establish a machine or local checkout. Credentials in URLs are refused. If the response is lost or saving is uncertain, use repositories_list/repository_get before retrying. Remove the reference in Settings \u003e Repositories to reverse the addition.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "Repository URL, repository page, or git SSH remote without credentials."
        },
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab"
          ],
          "description": "Required for a self-hosted GitHub/GitLab; other providers are detected from the host."
        },
        "name": {
          "type": "string",
          "maxLength": 80
        },
        "aliases": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "purpose": {
          "type": "string",
          "maxLength": 500
        }
      }
    }
  },
  {
    "name": "view_show",
    "description": "Create a persistent live card in the calling assistant conversation. Use the same View schema as persona-view and extension UI: sections of components, a required plain-text fallback, and optional named pages. The card stays at its feed position; use view_update to change it. The hub validates the View and returns field-level errors for correction. At most 64 KB per card and 200 cards per conversation. This does not send a push notification. Keep the conclusion in your normal reply too. Returns {id, version}; save the id for updates. Do not collect passwords or secrets in a card. An html component can call persona.reply / persona.open only when it has a key, and each call is confirmed by the user; the card's one reply is shared with its reply actions.",
    "input_schema": {
      "type": "object",
      "required": [
        "view"
      ],
      "properties": {
        "view": {
          "type": "object",
          "description": "A View from schema/extension/view.schema.json with a required plain-text fallback and sections. Only assistant reply/open/push.page/pop actions, not extension ui.action ids."
        }
      }
    }
  },
  {
    "name": "view_update",
    "description": "Replace a live card created by this assistant conversation with a complete validated View. Other conversations and ordinary agents cannot modify it. Supply the version read from view_get to reject stale updates; without it the hub uses the version it reads at the start of this call. Validation or a version conflict leaves the previous card intact. Contents are stored before update notifications are coalesced (at most one per second). Returns {version}. Keep stable component keys to preserve editing and scroll state across devices.",
    "input_schema": {
      "type": "object",
      "required": [
        "id",
        "view"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "The exact id returned by view_show, including its view_ prefix."
        },
        "view": {
          "type": "object",
          "description": "The entire replacement View, including required plain-text fallback."
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Expected version from view_get; a stale version returns a conflict instead of overwriting."
        }
      }
    }
  },
  {
    "name": "view_get",
    "description": "Read a persistent live card created by the calling assistant conversation. Returns its id, conversation, version, full View, timestamps and actions (the user's selected reply and submitted values, with pending/sent/failed delivery status; kind html is a reply from an html component's persona.reply, its text the reply the user confirmed; version is the card version the user saw when choosing). Use it before updating a card after resuming work; an id from another conversation is forbidden. Updating the card never clears a committed answer.",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "The exact live card id returned by view_show."
        }
      }
    }
  },
  {
    "name": "conversations_list",
    "description": "List your Persona conversations, newest activity first: id, title, tags, last activity, main/running state and last-message gist. Archived ones need `include_archived`; this conversation is marked. Use it to identify the user's conversation before reading, renaming, archiving, tagging or messaging it.",
    "input_schema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "case-insensitive match on title or last message"
        },
        "tag": {
          "type": "string",
          "description": "exact tag to match"
        },
        "include_archived": {
          "type": "boolean",
          "description": "include archived conversations (marked as such)"
        },
        "limit": {
          "type": "integer",
          "description": "default 30, max 100"
        }
      }
    }
  },
  {
    "name": "conversation_read",
    "description": "Read the recent part of another Persona conversation (an id from conversations_list): the user's messages, what was answered, tool calls in short form, cut like agent_read. `turns` = how many recent exchanges (default 2, max 10).",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "full id or its first 8 characters"
        },
        "turns": {
          "type": "integer"
        }
      }
    }
  },
  {
    "name": "conversation_rename",
    "description": "Rename: direction name via main-only direction_name (no date/kind); ordinary kind/topic becomes MMDD | kind | topic using its start date. User-chosen names/titles require user_asked. Main has no title.",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "conversation id or first 8 characters"
        },
        "name": {
          "type": "string",
          "maxLength": 40,
          "description": "direction: plain project-supervisor name"
        },
        "kind": {
          "type": "string",
          "enum": [
            "功能",
            "设计",
            "修复",
            "优化",
            "发布",
            "探索",
            "文档",
            "研究",
            "评审",
            "定时"
          ],
          "description": "ordinary conversation kind"
        },
        "topic": {
          "type": "string",
          "description": "ordinary topic, at most 14 characters"
        },
        "user_asked": {
          "type": "boolean",
          "description": "explicit user request to replace their title/name"
        }
      }
    }
  },
  {
    "name": "conversation_archive",
    "description": "Archive a Persona conversation: it leaves the sidebar's list (it is kept, and listed under 已归档), nothing is deleted. Only when the user asks to tidy up or archive. The main conversation can't be archived. Archiving this conversation itself is allowed: the current turn finishes, and a new message from the user brings it back.",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "full id or its first 8 characters"
        }
      }
    }
  },
  {
    "name": "conversation_unarchive",
    "description": "Bring an archived Persona conversation back into the sidebar's list (find it with conversations_list and include_archived).",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "full id or its first 8 characters"
        }
      }
    }
  },
  {
    "name": "conversation_tags_set",
    "description": "Replace a conversation's tags; [] clears them. These user-defined labels group conversations in apps and lists. They are trimmed and de-duplicated, at most 10 of 32 characters each. Tag only conversations in your own space when the user asks for tags or grouping; never invent them. This conversation is a valid id.",
    "input_schema": {
      "type": "object",
      "required": [
        "id",
        "tags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "full id or first 8 characters"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "complete replacement list; [] clears all"
        }
      }
    }
  },
  {
    "name": "conversation_new",
    "description": "Open a Persona conversation with a first message; returns its id. For threads the user asks for. Marked as from this one; named after its first turn and told to report with conversation_send. Failure or no report leaves one notice. A read-only policy may refuse: follow it, do not retry. Add `tags` only if asked.",
    "input_schema": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "everything the new conversation needs; it does not see this one"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "initial tags; trimmed and de-duplicated, at most 10 of 32 characters each"
        },
        "quote": {
          "type": "string",
          "description": "\"latest\" or a message id: the user's words, carried verbatim"
        }
      }
    }
  },
  {
    "name": "conversation_send",
    "description": "Message another conversation. It waits for a running turn or 2 min of user quiet. Marked as from this one; replies use conversation_send. Few hops per user message (main: no cap; a wake-up resets; a first reply adds none); long back-and-forth is cut. Past the rate it queues: the result says when, no resend. Don't reply just to acknowledge. Follow policy refusals; don't retry. Owner-verbatim words to main stay allowed: start with them. Handing on a user request: set quote (free once).",
    "input_schema": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "full id or its first 8 characters"
        },
        "text": {
          "type": "string"
        },
        "quote": {
          "type": "string",
          "description": "\"latest\" or a message id: the user's words, carried verbatim"
        }
      }
    }
  },
  {
    "name": "task_plan",
    "description": "Plan Agent work (code, repo research, or more than a few tool calls) instead of starting agents yourself: one task per independent piece. Check machines_list before choosing resources. Fill every field from the knowledge base, agents_list and user preferences; each choice is an editable chip with your one-line reason. Read-only tasks, tasks the user asked for themselves (user_requested), and kinds the user told you to start without asking, start at once; the rest wait as a card for the user's 开始. Returns immediately: carry on. Each queued task becomes a todo in your context snapshot; use agent_send to reach its Agent. Things a tool does for you (a reminder, an event) are not tasks. A task stays on its requested machine by default (machine_policy=fixed), including retries. An unavailable launcher fails there; do not reroute machine-local work. Use machine_policy=flexible only when the task may run on another computer: a failed health check can then move it, and its why says so. The response confirms queued dispatch, not an Agent start; check the task outcome. From a leader conversation (assistant.leaders) or any other side conversation you supervise what you hand out; you get a 督办 message when one needs you, and you close it with task_review, not by repeating its agent's words. What the main conversation hands out to no leader is followed up by the background supervisor by default (a built-in conversation that gets the 督办 messages and reviews with task_review; the main conversation may too), and by the main conversation itself, as a leader would, when assistant.main_supervises_own_tasks is on. A conversation that cannot be sent a 督办 message leaves what it hands out to that same follow-up, and gets a one-line notice with the task's link when each one ends. The answer says who follows up. The answer lists running work that looks like the same task: check it before letting both go on. A todo this conversation opened with no agent yet (a Lark topic's, named in the message that handed it over, a todo_create part_of piece, or a failed start) is the task's own: give it as todo_id and no new todo is made. From the main conversation, supervisor hands the whole plan to a leader conversation (one of assistant.leaders), which supervises and reviews its tasks as if it had handed them out; leave it out for work of no direction. Every task gets a brief, kept from the moment it starts and never rewritten: the hub records the owner's message that led to it (their words, from this conversation; work you start on your own after a 督办 message, a notice or a routine is recorded as yours, with started_why), and you supply the goal, done_when, expect_minutes and out_of_bounds. A writable task (readonly false) without done_when (at least one checkable result) and expect_minutes is refused, and so is a read-only task without goal and expect_minutes; the refusal says what is missing. The card shows the brief, so the owner's 开始 confirms it. For rework, replacement or a retry on another computer, give continues and continues_why (see continues); a start that did not come up is retried with task_retry, also on another launcher. Apply owner-authorized scope changes with task_scope before planning and pass its scope_revision to reject staleness. Supply goal, authorization bounds, and new information; the manager appends effective criteria. A task that changes files sets readonly false with explicitly authorized writable permission (for example, Codex bypassPermissions), which also lets a replacement Agent on the same todo implement fixes. A read-only Codex sandbox cannot be changed in place: use a fresh writable process; with no permission change, a plain agent_send follow-up to the live Agent is fine. A task that only reads sets readonly true; its first message includes the read-only constraint. Claude-family launchers use bypassPermissions for both read-only and writable tasks; Codex uses plan unless assistant.readonly_mode=prompt (normal runtime permissions, not a security boundary). pi, cursor and agy have no read-only mode and are refused in either setting. role \"leader\" makes the task's agent a task leader: it hands direct workers to its own task through its own restricted task_plan and task_review and gets their supervision messages; only for a task that splits into several agents' work. Its workers cannot hand tasks on.\n\nWhen repository identity needs resolving, consult repositories_list, and repository_get only when useful. The user's explicit repository URL or path takes precedence. A saved binding is a reference, not authorization or an allowlist; never infer a machine or checkout path from it. Non-repository tasks need no lookup; retrieval is not a mandatory dispatch preflight. Closing the terminal on acceptance is the owner's Start choice; this tool cannot set it.\n\nWorkspace policy: \"new\" makes an isolated checkout; {\"new\":{\"branch\":\"task/my-change\"}} names its branch; {\"existing\":\"\u003ccwd or workspace_id\u003e\"} selects one; \"none\" creates nothing. Omitted: readonly uses none; writable Git follows assistant.task_workspace_preference (prefer-existing by default, prefer-new for isolation), and an occupied cwd uses new. Explicit existing never switches silently; refusal names its task owner. For an explicit new branch already checked out, reuse requires a clean checkout, no live Agent and no unfinished-task owner; otherwise refuse with its path and known owner. The machine's engine owns creation, location and registration; never run git worktree add. The card previews the path and is editable before Start. Default branch: task/\u003ctodo id\u003e. Creation failure starts no Agent. Workspaces remain after acceptance. Organization read-only policy refusals include their reason: follow it, never retry unchanged.\n\n`wait_seconds` observes up to 50 seconds after dispatch, appending `Inline observation` JSON: `completed`(this input's `reply`), `question`(pending `interaction_id`), `timeout`/`cancelled`/`unavailable`/`interrupted`/`failed`, with known input/session ids. Observation never answers questions, accepts tasks, resends or cancels work; normal supervision/`task_review` applies. Older nodes may time out rather than return an unrelated reply. Only an immediately dispatchable single-task plan waits; approval cards and multi-task plans return immediately.",
    "input_schema": {
      "type": "object",
      "required": [
        "tasks"
      ],
      "properties": {
        "wait_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "0/omitted: normal receipt"
        },
        "supervisor": {
          "type": "string",
          "description": "main only: leader conversation id (assistant.leaders); it supervises; omit for no direction or your own work"
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "title",
              "prompt",
              "machine",
              "cwd",
              "readonly",
              "user_requested",
              "why"
            ],
            "properties": {
              "title": {
                "type": "string",
                "description": "the task in a short line the user reads on the card (Chinese, under 20 characters)"
              },
              "prompt": {
                "type": "string",
                "description": "the agent's first message: everything it needs to do the task without asking you"
              },
              "machine": {
                "type": "string",
                "description": "machine id; fixed target by default"
              },
              "machine_policy": {
                "type": "string",
                "enum": [
                  "fixed",
                  "flexible"
                ],
                "description": "fixed (default): keep this machine; flexible: permit health-based moves only for portable work"
              },
              "cwd": {
                "type": "string",
                "description": "the project directory: absolute path or ~/…"
              },
              "workspace": {
                "type": [
                  "string",
                  "object"
                ],
                "description": "workspace policy; omit for default; existing: absolute/~/path or workspace id on that machine; no custom root",
                "oneOf": [
                  {
                    "type": "string",
                    "enum": [
                      "new",
                      "none"
                    ]
                  },
                  {
                    "type": "object",
                    "required": [
                      "existing"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "existing": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "new"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "new": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "branch": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                ]
              },
              "launcher": {
                "type": "string",
                "description": "listed launcher (Claude Code, pi, cursor or agy in herdr); unknown names refused with choices; empty: default/fallback, claude first, why says which"
              },
              "model": {
                "type": "string",
                "description": "model id or alias the agent takes; empty: the launcher's default"
              },
              "permission": {
                "type": "string",
                "enum": [
                  "default",
                  "acceptEdits",
                  "plan",
                  "auto",
                  "bypassPermissions"
                ],
                "description": "mode; empty: writable default; readonly/replacement/Codex rules: see description; traex and omp take none"
              },
              "role": {
                "type": "string",
                "enum": [
                  "leader"
                ],
                "description": "leader (any conversation): may hand direct workers to its own task; omit for an ordinary worker"
              },
              "ultracode": {
                "type": "boolean",
                "description": "large tasks (many files, multi-angle checks): Claude Code multi-agent workflows for substantial steps, slower/costlier; small tasks: false; Claude Code 2.1.284+ only, otherwise starts without it; never put it in prompt/title"
              },
              "readonly": {
                "type": "boolean",
                "description": "true only for a task that must remain read-only; false for authorized file changes (a Codex read-only sandbox: see the description). The first message adds「本任务只读：不改项目文件、不提交、不对外写入」 only when true"
              },
              "user_requested": {
                "type": "boolean",
                "description": "true when the user asked for this very task in their latest message (told you to do it, to have an agent do it, to go ahead and start); false when it is your own idea or inferred from something they did not ask for"
              },
              "why": {
                "type": "string",
                "description": "one line (Chinese) on why this machine, directory and model"
              },
              "done_when": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "string"
                },
                "description": "what done means: results you will check before you accept it (Chinese, one each), e.g. 「PR 合并到 master」「浅色 / 深色截图贴进 PR」「线上 hub 已部署并验证」; the agent is told them. Required for a writable task (at least one); with continues the effective criteria from the original to-do apply and this is ignored"
              },
              "goal": {
                "type": "string",
                "description": "the work in one sentence, as the owner would say what they get from it (Chinese); required for a read-only task, the title when left out of a writable one"
              },
              "out_of_bounds": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "string"
                },
                "description": "optional: what the agent must not do or touch (Chinese, one each), e.g. 「不合并」「不动线上」"
              },
              "continues": {
                "type": "string",
                "description": "optional: the original todo id this task continues. Continuations always reuse this same todo and its original brief and effective criteria; never split work to a new todo. At Start, stop/release still-active prior Agents and reopen this todo if closed. Refuse unauthorized takeovers, an unreachable prior Agent that cannot be stopped, and legacy open successor duplicates. Failed starts keep this todo. Needs continues_why; if no permission change is wanted, agent_send can follow up the same live Agent"
              },
              "scope_revision": {
                "type": "string",
                "description": "with continues after a scope change: the exact scope_revision returned by task_scope; refuse planning if it is stale"
              },
              "continues_why": {
                "type": "string",
                "description": "with continues: one line on why the earlier task stopped or needs a replacement; kept on this continuation's plan"
              },
              "started_why": {
                "type": "string",
                "description": "when the owner did not just ask for this (your own idea, something a 督办 message or a routine led to): one line on why you start it; kept on the brief"
              },
              "attachments": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "string"
                },
                "description": "absolute paths of pictures/files the user gave in this conversation (Claude Code path or app attachment); copied to the agent, appended to its message with mentions updated; others refused"
              },
              "expect_minutes": {
                "type": "integer",
                "minimum": 0,
                "description": "about how long the task should take, in minutes; required (above 0) unless continues is given. A task with no progress for 1.5× that (at least 20 minutes) counts as stuck, and one with no end after 3× that (at least a day) is raised to you as overdue"
              },
              "project": {
                "type": "string",
                "description": "optional: its knowledge-base project, an existing one's slug or name (kb_list projects), set when the area of work is clear; never a near-duplicate"
              },
              "part_of": {
                "type": "string",
                "description": "optional: the request to-do this is a piece of"
              },
              "after": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "with part_of: the pieces it waits for"
              },
              "todo_id": {
                "type": "string",
                "description": "optional: an open or failed-start todo this conversation opened or supervises, with no live Agent (stopped ones are released at Start). To stop a live Agent or reopen a done one use continues; given both, they name the same todo"
              },
              "inbox_item": {
                "type": "string",
                "description": "Exact handed-off Inbox id for related work only. Checked against this conversation and manager; links the task without filing or replying."
              },
              "tier": {
                "type": "string",
                "description": "Agent preset from the snapshot's 模型档位 line; choose by purpose; resolved at task start with its profile; explicit launcher/model/effort/speed overrides"
              },
              "speed": {
                "type": "string",
                "enum": [
                  "standard",
                  "fast",
                  "ultrafast"
                ],
                "description": "new-start speed; explicit choice overrides the tier. standard/omitted: launcher default. Codex: fast, ultrafast; Claude Code: fast only"
              },
              "effort": {
                "type": "string",
                "description": "Explicit effort; omit for tier/purpose default."
              }
            }
          }
        }
      }
    }
  },
  {
    "name": "task_plan_withdraw",
    "description": "Take down a plan card this conversation put up (task_plan) while nothing of it has started: its work was done elsewhere, or the user decided not to do it. The card stops waiting for the user's 开始, as when they dismiss it themselves, and leaves the to-handle lists (the snapshot's plans waiting to start, the briefings). Only for a plan of this conversation that still waits for 开始; a started or dismissed plan, or another conversation's, is refused and nothing changes. Your reason is kept on record; tell the user in a line which card you took down and why.",
    "input_schema": {
      "type": "object",
      "required": [
        "plan_id",
        "reason"
      ],
      "properties": {
        "plan_id": {
          "type": "string",
          "description": "the plan's id (plan_…), as task_plan's answer or the snapshot's plans waiting to start give it"
        },
        "reason": {
          "type": "string",
          "description": "why it is no longer needed, in the user's language, one sentence"
        }
      }
    }
  },
  {
    "name": "task_review",
    "description": "Verify handed-out work. accepted closes the task; its terminal stays unless the owner opted in at Start, when accepted done closes its idle tab once saved. Report the cleanup result (closed, skipped or pending); never close the tab yourself or ask to. rework sends gaps to that Agent: at most 2 rounds; a third requires a complete owner decision. A stopped Agent is read-only: replace with agent_start. External waits use parked with source evidence, not needs_user. Only answerable owner-only decisions use needs_user: why_owner, reason, recommend, 2–4 options (recommended first, each with leads_to), cost_of_waiting. Otherwise act within your authority, rework or close.\n\naccepted with outcome done (default) and current done_when requires every criterion exactly once in checks, met=true with nonblank evidence. Refuse missing/duplicate/unknown/unmet checks before writing; user_check cannot bypass this. outcome cannot, cancelled and no-criteria tasks are unchanged. Other verdicts may omit checks without erasing progress. Report each criterion as met, not met or dropped (logged scope change), then also_done. Judge the scoped brief, not a later handover or the Agent's word; review every task supervision asks you to.\n\nSupervised accepted/needs_user send one Lark conclusion card (verdict, reason, link; needs_user adds recommend, selected by “OK”); do not duplicate it. Give accepted's outcome/reason/link or needs_user's reason/recommend. Acceptance passes an existing “Please verify” card; user_check means the owner must still inspect. needs_user defaults to recommend after 24h/deadline except irreversible or visible_to_others: never default those, remind daily. Recheck once at 24h. can_wait requires nobody blocked today, low waiting cost and no deadline within 12h (see schema). “You decide”, “This isn't what I asked for”, “Tell me the background first” return to supervision: don't repeat the question or take irreversible/external action.\n\nA non-main conversation reviewing another supervisor's task may only accept/cancel; send gaps with agent_send. A leader's needs_user reaches main too. Cancel only duplicates/unwanted tasks; their Agents close/archive and waiting cards end.",
    "input_schema": {
      "type": "object",
      "required": [
        "todo_id",
        "verdict"
      ],
      "properties": {
        "todo_id": {
          "type": "string",
          "description": "the task's todo id (todo_…), from the 督办 message or the context snapshot"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "accepted",
            "rework",
            "needs_user",
            "parked",
            "cancelled"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "criterion",
              "met"
            ],
            "properties": {
              "criterion": {
                "type": "string",
                "description": "one done_when criterion (or what the task was for, when it had none)"
              },
              "met": {
                "type": "boolean"
              },
              "evidence": {
                "type": "string",
                "description": "what shows it is met (a link, a command's output), or what is missing"
              }
            }
          },
          "description": "each criterion, met or not, with its evidence or gap; updates that done_when entry's persisted state, evidence, time and supervisor identity. Omitted entries keep their progress"
        },
        "note": {
          "type": "string",
          "description": "rework: what the agent is to do (Chinese, concrete); needs_user: what the user is to decide; parked: anything more than reason, for your own record; cancelled: why; accepted: the result in a line"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "done",
            "cannot"
          ],
          "description": "accepted: done (the work is done or the answer is yes), or cannot (the task found it cannot be done); default done"
        },
        "reason": {
          "type": "string",
          "description": "accepted: the conclusion card's one sentence of why, in the user's language; default the note's first line. needs_user (required): one sentence saying what is to be decided, in the user's language. parked (required): one sentence saying what the task waits for, in the user's language; waiting on a PR: include its link"
        },
        "waiting_on": {
          "type": "string",
          "enum": [
            "someone_else",
            "external_event",
            "date"
          ],
          "description": "parked (required): the external wait. someone_else: another person must act or answer; external_event: an outside event must happen; date: wait only until a date. New owner decisions use needs_user; legacy owner_priority parks remain readable and retain their digest behavior"
        },
        "until": {
          "type": "string",
          "description": "parked, optional: duration (\"3d\", \"36h\", \"90m\") or RFC 3339 time, 1 minute to 30 days ahead; default 24h. For waiting_on date, give an explicit RFC 3339 time (no duration or default). At that time the task returns to supervision"
        },
        "link": {
          "type": "string",
          "description": "accepted and needs_user: the one link to the evidence (the PR, the page, the document); default the task's PR, a link in the note or checks, or the agent's conversation"
        },
        "recommend": {
          "type": "string",
          "description": "needs_user (required): the option you recommend, the label of the first of options; the user's \"OK\" takes it and it goes to the task's agent"
        },
        "why_owner": {
          "type": "string",
          "enum": [
            "irreversible",
            "visible_to_others",
            "priority",
            "acceptance",
            "only_owner_knows"
          ],
          "description": "needs_user (required): why only the user can decide. irreversible: a step that cannot be undone (deleting, a production release or write, spending money); visible_to_others: something other people will see (a message, a comment, a review request); priority: whether to do it or what comes first; acceptance: a result they have to judge by eye; only_owner_knows: a fact only they have. Anything else is yours to decide"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "label",
              "leads_to"
            ],
            "properties": {
              "label": {
                "type": "string",
                "description": "the option in a few words, as a button says it"
              },
              "leads_to": {
                "type": "string",
                "description": "one sentence: what choosing it leads to"
              }
            }
          },
          "description": "needs_user (required): 2 to 4 options the user chooses from, the recommended one first"
        },
        "cost_of_waiting": {
          "type": "string",
          "description": "needs_user (required): one sentence saying what it costs if the user does not answer soon"
        },
        "can_wait": {
          "type": "boolean",
          "description": "needs_user, optional: true when the decision can wait for the next daily briefing (no deadline within 12 hours, a low cost_of_waiting): it is not pushed and has no card, and is in the user's Needs you at once. Ignored (the answer says why) for why_owner irreversible and visible_to_others, a deadline within 12 hours or with reversible false, and when no daily briefing with facts is due within 24 hours and at least 12 hours before the deadline (24 hours by default: give a longer deadline for what can wait longer); default false (pushed as usual)"
        },
        "deadline": {
          "type": "string",
          "description": "needs_user, optional: until when the decision waits, a duration (\"4h\", \"90m\") or an RFC 3339 time, 1 minute to 30 days ahead; needs reversible. Default: 24h and reversible, except for why_owner irreversible and visible_to_others, which have none"
        },
        "also_done": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string"
          },
          "description": "accepted, optional: what was done beyond the task's brief (one line each); the task's page lists it after the criteria"
        },
        "user_check": {
          "type": "boolean",
          "description": "accepted only: the user is still to look at the result themselves (a UI change someone has to see): a \"Please verify\" card waits for their \"Pass\" instead of your acceptance passing it; default false"
        },
        "reversible": {
          "type": "boolean",
          "description": "with deadline: whether taking recommend can be undone later. false for deleting, sending anything to other people, spending money or changing production: those are never taken by default (why_owner irreversible and visible_to_others must say false)"
        },
        "evidence": {
          "type": "object",
          "required": [
            "kind",
            "target",
            "wake"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "person_reply",
                "merge_review",
                "external_event",
                "date"
              ],
              "description": "parked: person_reply (a sent request to a person), merge_review (a sent request for review of a ready PR/MR), external_event (an observable outside event), or date"
            },
            "target": {
              "type": "string",
              "maxLength": 200,
              "description": "the named person/reviewer or external object"
            },
            "wake": {
              "type": "string",
              "maxLength": 600,
              "description": "the observable change that ends this wait"
            },
            "url": {
              "type": "string",
              "maxLength": 2000,
              "description": "required for merge_review (ready PR/MR link) and external_event (observable object URL); omit for person_reply and date"
            },
            "contact": {
              "type": "object",
              "required": [
                "channel",
                "url",
                "sender",
                "sent_at",
                "request",
                "status"
              ],
              "properties": {
                "channel": {
                  "type": "string",
                  "maxLength": 100
                },
                "url": {
                  "type": "string",
                  "maxLength": 2000,
                  "description": "sent-message/receipt link, not a channel homepage"
                },
                "sender": {
                  "type": "string",
                  "maxLength": 200
                },
                "sent_at": {
                  "type": "string",
                  "format": "date-time",
                  "description": "actual sent time; not in the future"
                },
                "request": {
                  "type": "string",
                  "maxLength": 600
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "sent"
                  ]
                }
              },
              "description": "required for person_reply and merge_review: the request has already been sent"
            },
            "ready": {
              "type": "boolean",
              "enum": [
                true
              ],
              "description": "merge_review only: the named reviewer can review the PR/MR"
            },
            "reply": {
              "type": "object",
              "required": [
                "source",
                "brand",
                "app_id",
                "account_open_id",
                "person_open_id",
                "chat_id",
                "thread_id",
                "request_message_id"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "enum": [
                    "larkcli"
                  ]
                },
                "brand": {
                  "type": "string",
                  "enum": [
                    "feishu",
                    "lark"
                  ]
                },
                "app_id": {
                  "type": "string"
                },
                "account_open_id": {
                  "type": "string"
                },
                "person_open_id": {
                  "type": "string",
                  "description": "expected human OpenID in this app, not self"
                },
                "chat_id": {
                  "type": "string"
                },
                "thread_id": {
                  "type": "string",
                  "description": "provider topic ID, not root-message ID"
                },
                "request_message_id": {
                  "type": "string"
                }
              },
              "description": "person_reply: exact IDs from a configured lark-cli reader, never names. contact.url must be the sent request's matching topic AppLink. A verified reply asks the current supervisor to review, not direct Agent delivery"
            }
          },
          "description": "required for parked. Inspect the source receipt: this records your attestation, not a provider check. Do not supply recorded_by (current conversation, server-authored/output only). Legacy missing evidence is unrecorded, not verified"
        }
      }
    }
  },
  {
    "name": "task_scope",
    "description": "Change what a task you supervise is to do, or what done means for it, after it started (its todo id). The task's brief (the owner's request and the criteria it started with) is never rewritten: this adds an entry to the brief's log with what changed and why, applies the new done_when and expect_minutes, restarts the task's clock, and the owner reads the change in their next digest. It is the only way done_when changes after a task started (agent_supervise and agent_send with a task on your own task go through the same log). Give done_when as the whole list after the change: a criterion you leave out is recorded as dropped by this change, and the completion report says so. A change that adds a step only the owner may allow (deploying, merging, releasing, sending or commenting where other people see it, deleting, spending, changing production) and was not part of the task is refused unless the owner's own message started this turn: ask them first (ask_user, or task_review needs_user), then call it again when they answered. Only the task's supervisor may call it. The agent is not told: send it what changed with agent_send. Use it also to answer an overdue task that is still right: say why and give the new expect_minutes.",
    "input_schema": {
      "type": "object",
      "required": [
        "todo_id",
        "change",
        "why"
      ],
      "properties": {
        "todo_id": {
          "type": "string",
          "description": "the task's todo id (todo_…)"
        },
        "change": {
          "type": "string",
          "description": "what changes, in one sentence the owner can read (Chinese), e.g. 「不再要求灰度验证，改为只在测试环境验证」"
        },
        "why": {
          "type": "string",
          "description": "why, in one sentence (Chinese)"
        },
        "done_when": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string"
          },
          "description": "the criteria after the change, the whole list; leave it out to keep them as they are"
        },
        "expect_minutes": {
          "type": "integer",
          "minimum": 0,
          "description": "how long the task should take from now; leave it out (or 0) to keep it"
        }
      }
    }
  },
  {
    "name": "task_decided",
    "description": "Record the owner's needs_user choice; main chat or supervisor only. Quote their words and exact option; never guess. told_agent=true means already delivered (also direct Agent chat): record only. Otherwise send and record. Both settle the ask.",
    "input_schema": {
      "type": "object",
      "required": [
        "todo_id",
        "option",
        "said"
      ],
      "properties": {
        "todo_id": {
          "type": "string",
          "description": "task id"
        },
        "option": {
          "type": "string",
          "description": "exact option label"
        },
        "said": {
          "type": "string",
          "description": "owner's words"
        },
        "told_agent": {
          "type": "boolean",
          "description": "true: already delivered to the Agent, record only; false: relay and record"
        }
      }
    }
  },
  {
    "name": "task_start_screen",
    "description": "Read the last 30 lines of the terminal tab a task's agent did not start in, while its computer keeps that tab (a 督办 message says until when): the question the tab's shell waits on, or where the agent's own screen stopped. Only for a task of this conversation whose start is being remedied; what it shows stays here, it is not kept with the task.",
    "input_schema": {
      "type": "object",
      "required": [
        "todo_id"
      ],
      "properties": {
        "todo_id": {
          "type": "string",
          "description": "the task's id, as the 督办 message gives it"
        },
        "reason": {
          "type": "string",
          "description": "why you look, in the user's language (optional; kept with the task's history)"
        }
      }
    }
  },
  {
    "name": "task_start_keys",
    "description": "Type into the terminal tab a task's agent did not start in, while its computer keeps that tab and no agent runs there: text as is (no enter, at most 32 characters), then keys by name (\"enter\", \"esc\", \"ctrl+c\", \"y\", \"n\", \"up\", \"down\"…, at most 8). Use it to answer the question the tab's shell waits on, or to get past where the agent's screen stopped; read the tab first with task_start_screen and again after. The keys, the text and your reason are kept with the task's history. It starts nothing: start the agent again with task_retry.",
    "input_schema": {
      "type": "object",
      "required": [
        "todo_id",
        "reason"
      ],
      "properties": {
        "todo_id": {
          "type": "string",
          "description": "the task's id, as the 督办 message gives it"
        },
        "text": {
          "type": "string",
          "maxLength": 32,
          "description": "text to type as is, before the keys"
        },
        "keys": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          },
          "description": "keys to press after the text, by name"
        },
        "reason": {
          "type": "string",
          "description": "why these keys, in the user's language, one sentence"
        }
      }
    }
  },
  {
    "name": "task_retry",
    "description": "Start a failed task's agent again: in its kept tab (once task_start_keys answered what stopped it), else in a new tab, reopening it; with launcher, on that launcher of the same computer and workspace. At most 3 retries; the hub never retries itself. Returns at once; the outcome comes as a 督办 message. Only this conversation's tasks; reason goes in their history.",
    "input_schema": {
      "type": "object",
      "required": [
        "todo_id",
        "reason"
      ],
      "properties": {
        "todo_id": {
          "type": "string",
          "description": "the task's id, from the 督办 message"
        },
        "reason": {
          "type": "string",
          "description": "why it should start now, in the user's language, one sentence"
        },
        "launcher": {
          "type": "string",
          "description": "optional: another launcher of that computer, as the 督办 message lists"
        },
        "model": {
          "type": "string",
          "description": "with launcher: a model id (default: its own)"
        }
      }
    }
  },
  {
    "name": "todo_repositories_get",
    "description": "Read a to-do's saved repository/issue/PR associations and catalog status. No Git/network calls.",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "todo_repositories_set",
    "description": "Replace atomically using revisions from todo_repositories_get/repositories_list. [] removes metadata. Frozen source snapshots: remove/reselect to adopt catalog identity changes. Editable after execution. Omit links to keep; [] clears. Omitted/empty titles keep. Reread/reconcile conflicts. No files, progress or completion changes.",
    "input_schema": {
      "type": "object",
      "required": [
        "id",
        "expected_revision",
        "expected_catalog_revision",
        "repositories"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "expected_catalog_revision": {
          "type": "integer",
          "minimum": 0
        },
        "repositories": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "repo_id"
            ],
            "properties": {
              "repo_id": {
                "type": "string"
              },
              "directory_alias": {
                "type": "string"
              },
              "requested_ref": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "default",
                      "branch",
                      "tag",
                      "commit",
                      "ref"
                    ]
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "default"
                      }
                    }
                  },
                  {
                    "required": [
                      "value"
                    ]
                  }
                ]
              },
              "links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "issue",
                        "pull_request"
                      ]
                    },
                    "number": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]{0,19}$"
                    },
                    "title": {
                      "type": "string",
                      "description": "Plain source title; trim; ≤1024 UTF-8 bytes.",
                      "maxLength": 1024
                    }
                  },
                  "additionalProperties": false,
                  "oneOf": [
                    {
                      "required": [
                        "url"
                      ],
                      "not": {
                        "anyOf": [
                          {
                            "required": [
                              "kind"
                            ]
                          },
                          {
                            "required": [
                              "number"
                            ]
                          }
                        ]
                      }
                    },
                    {
                      "required": [
                        "kind",
                        "number"
                      ],
                      "not": {
                        "required": [
                          "url"
                        ]
                      }
                    }
                  ]
                },
                "maxItems": 50
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "todo_repository_links_set",
    "description": "Set saved-source links. [] clears; absent/empty titles keep. Reread conflicts. Metadata only.",
    "input_schema": {
      "type": "object",
      "required": [
        "id",
        "repo_id",
        "expected_revision",
        "links"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "repo_id": {
          "type": "string"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "links": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "issue",
                  "pull_request"
                ]
              },
              "number": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,19}$"
              },
              "title": {
                "type": "string",
                "description": "Plain source title; trim; ≤1024 UTF-8 bytes.",
                "maxLength": 1024
              }
            },
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "url"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "kind"
                      ]
                    },
                    {
                      "required": [
                        "number"
                      ]
                    }
                  ]
                }
              },
              {
                "required": [
                  "kind",
                  "number"
                ],
                "not": {
                  "required": [
                    "url"
                  ]
                }
              }
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "todo_repository_links_add",
    "description": "Atomically add 1–50 exact issue/PR URLs across links:[{url,title}] and legacy urls. Auto-group even unlisted repositories; no manual entry. Actual titles only: nonempty refreshes, omitted/empty keeps. Deduplicate; explicit adds can restore removed links. Preserve aliases, refs and source snapshots. Replace/remove via todo_repositories_get and revision-checked set tools. Associations never prove completion.",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "urls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "string"
          }
        },
        "links": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string"
              },
              "title": {
                "type": "string",
                "description": "Full plain source title; ≤1,024 UTF-8 bytes after trimming.",
                "maxLength": 1024
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "urls"
          ]
        },
        {
          "required": [
            "links"
          ]
        }
      ]
    }
  },
  {
    "name": "todo_list",
    "description": "List Persona to-dos (not Feishu tasks): open/failed starts by default, due first and undated last. Returns id, title/state, priority/project, due/reminder, agents and first note line; times use the user's time zone. Filter by the schema fields. Find an id here before edits; use todo_get for details.",
    "input_schema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "open",
            "done",
            "all"
          ],
          "description": "Default: open."
        },
        "due_before": {
          "type": "string",
          "description": "Due no later than this date (inclusive through day's end) or datetime (user's time zone/RFC3339); excludes undated to-dos."
        },
        "due_after": {
          "type": "string",
          "description": "Due from this date/datetime onward; excludes undated to-dos."
        },
        "overdue": {
          "type": "boolean",
          "description": "Open and past due."
        },
        "with_agents": {
          "type": "boolean",
          "description": "true: with agents (tasks); false: user's own."
        },
        "query": {
          "type": "string",
          "description": "words to find in the title or notes"
        },
        "project": {
          "type": "string",
          "description": "Existing knowledge-base project slug/name."
        },
        "kind": {
          "type": "string",
          "enum": [
            "todo",
            "concern"
          ],
          "description": "todo or user-raised concerns awaiting concern_report; omitted includes both."
        },
        "limit": {
          "type": "integer",
          "description": "Default 50; maximum 200."
        }
      }
    }
  },
  {
    "name": "todo_get",
    "description": "Read a to-do's title/state, priority, due/reminder and push status, timestamps, origin/plan, notes, agents, decisions and canonical repository/issue/PR associations. Maintain links with todo_repository_links_add or the revision-checked set tools; associations do not prove completion.",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "the to-do's id (todo_…), as todo_list gives it"
        }
      }
    }
  },
  {
    "name": "todo_create",
    "description": "Record requested/agreed work or reminders immediately, without confirmation; execute via task_plan. Open title/due duplicates return existing to-dos but refuse bindings: use todo_repositories_get/set. Short title in the user's language; details in notes. In leader chats: record that direction's work; task_plan dispatches, todo_complete finishes unassigned work. Bindings save atomically; IDs/catalog_revision from repositories_list. No files or task progress changes.",
    "input_schema": {
      "type": "object",
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "description": "what is to be done, in a line, in the user's language"
        },
        "notes": {
          "type": "string",
          "description": "Details."
        },
        "due": {
          "type": "string",
          "description": "Day only: YYYY-MM-DD; otherwise YYYY-MM-DD HH:MM (user time zone) or RFC3339. Relative 2h/3d accepted."
        },
        "remind": {
          "type": "string",
          "description": "Future reminder (user time zone/RFC3339 or relative 30m/2h/1d). Only if requested or deadline close and important."
        },
        "priority": {
          "type": "string",
          "enum": [
            "high",
            "normal",
            "low"
          ],
          "description": "normal when left out"
        },
        "kind": {
          "type": "string",
          "enum": [
            "todo",
            "concern"
          ],
          "description": "todo (default); concern (main chat only) tracks a user-raised matter until concern_report reports its outcome; other completion tools cannot close it."
        },
        "project": {
          "type": "string",
          "description": "Existing kb_list project slug/name; prefer long-term work. Only when clear; no near-duplicates."
        },
        "part_of": {
          "type": "string",
          "description": "Request to-do id this is a piece of; hand out via task_plan todo_id."
        },
        "after": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "With part_of: sibling piece ids it waits for."
        },
        "repository_bindings": {
          "type": "object",
          "required": [
            "catalog_revision",
            "repositories"
          ],
          "properties": {
            "catalog_revision": {
              "type": "integer",
              "minimum": 0
            },
            "repositories": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "required": [
                  "repo_id"
                ],
                "properties": {
                  "repo_id": {
                    "type": "string"
                  },
                  "directory_alias": {
                    "type": "string"
                  },
                  "requested_ref": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "default",
                          "branch",
                          "tag",
                          "commit",
                          "ref"
                        ]
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "kind"
                    ],
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "default"
                          }
                        }
                      },
                      {
                        "required": [
                          "value"
                        ]
                      }
                    ]
                  },
                  "links": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "url": {
                          "type": "string",
                          "minLength": 1
                        },
                        "kind": {
                          "type": "string",
                          "enum": [
                            "issue",
                            "pull_request"
                          ]
                        },
                        "number": {
                          "type": "string",
                          "pattern": "^[1-9][0-9]{0,19}$"
                        },
                        "title": {
                          "type": "string",
                          "description": "Plain source title; trim; ≤1024 UTF-8 bytes.",
                          "maxLength": 1024
                        }
                      },
                      "additionalProperties": false,
                      "oneOf": [
                        {
                          "required": [
                            "url"
                          ],
                          "not": {
                            "anyOf": [
                              {
                                "required": [
                                  "kind"
                                ]
                              },
                              {
                                "required": [
                                  "number"
                                ]
                              }
                            ]
                          }
                        },
                        {
                          "required": [
                            "kind",
                            "number"
                          ],
                          "not": {
                            "required": [
                              "url"
                            ]
                          }
                        }
                      ]
                    },
                    "maxItems": 50
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  {
    "name": "todo_update",
    "description": "Update supplied title, notes, due/reminder, priority, project, part_of or after immediately, including task to-dos; no confirmation. Omitted fields stay; \"\" clears notes/due/remind/project/part_of, [] clears after. New reminder times notify again. Completion/reopening uses todo_complete/todo_reopen.",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "To-do id from todo_list."
        },
        "title": {
          "type": "string",
          "description": "the new title"
        },
        "notes": {
          "type": "string",
          "description": "Replacement notes; retain anything still needed. \"\" clears."
        },
        "due": {
          "type": "string",
          "description": "New due date YYYY-MM-DD or datetime (user's time zone/RFC3339); \"\" clears."
        },
        "remind": {
          "type": "string",
          "description": "New reminder datetime (user's time zone/RFC3339) or relative 30m/2h/1d; never past. \"\" clears."
        },
        "priority": {
          "type": "string",
          "enum": [
            "high",
            "normal",
            "low"
          ]
        },
        "project": {
          "type": "string",
          "description": "Existing knowledge-base project slug/name (kb_list projects), preferably a long-term work area. Set only when clear; do not invent near-duplicates. \"\" clears."
        },
        "part_of": {
          "type": "string",
          "description": "Request to-do this is a piece of; changing clears after."
        },
        "after": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Sibling piece ids it waits for; replaces old."
        }
      }
    }
  },
  {
    "name": "todo_complete",
    "description": "Mark one of the user's Persona to-dos done, when the user says it is done (or asks you to close it). The user's own to-do is closed at once. A task's, or one agents work on, is confirmed on the phone first, because closing it also closes its agents once they are idle; if the user declines, nothing changes. A concern is not closed with this: report its outcome with concern_report.",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "the to-do's id (todo_…), as todo_list gives it"
        }
      }
    }
  },
  {
    "name": "todo_reopen",
    "description": "Open a done Persona to-do again, when the user says it is not done after all. The user's own to-do is reopened at once; a task's, or one agents worked on, is confirmed on the phone first.",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "the to-do's id (todo_…), as todo_list gives it"
        }
      }
    }
  },
  {
    "name": "todo_delete",
    "description": "Delete one of the user's Persona to-dos for good (its notes, links to agents and decisions go with it), only when the user asks for it to be deleted; one that is finished is completed instead (todo_complete). Every delete is confirmed on the phone first; if the user declines, writes instead, or does not answer, nothing is deleted. The agents that worked on it are left as they are.",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "the to-do's id (todo_…), as todo_list gives it"
        }
      }
    }
  },
  {
    "name": "concern_report",
    "description": "Report the outcome of one of the user's concerns (a to-do of kind concern, see todo_list kind concern) and close it: main conversation only. Call it in the same reply in which you tell the user the outcome, with report the words you told them, faithfully; it is kept on the concern as a decision of source reported (shown in the app, sent to extensions). It is the only way a concern closes: nothing closes one on its own, and todo_complete refuses it. Report only an outcome the user has actually been told; if the concern is not settled yet, leave it open. A concern the user reopens needs another report.",
    "input_schema": {
      "type": "object",
      "required": [
        "id",
        "report"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "the concern's id (todo_…), as todo_list gives it"
        },
        "report": {
          "type": "string",
          "description": "what you told the user of its outcome, as you said it in this reply (at most 4000 characters)"
        }
      }
    }
  },
  {
    "name": "direction_name",
    "description": "Name a direction (a leader conversation, one of assistant.leaders, current or ended): main conversation only. The name is what the app and the work-log extension show for the direction, so make it short and plain, the way the user calls that line of work (「Persona 产品」「基建」), never a conversation title with a date or kind in it. An empty name takes yours away: the direction then shows its knowledge-base project's name, else its conversation title without the date and kind. Whoever names it last, the user in the app or you, that name shows.",
    "input_schema": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "the leader conversation's id (persona_settings get assistant.leaders, conversations_list)"
        },
        "name": {
          "type": "string",
          "description": "the direction's name, at most 40 characters; empty to clear it"
        }
      }
    }
  },
  {
    "name": "leader_progress",
    "description": "Report your direction's progress to the user's work log: leader conversations only (assistant.leaders). Write at the goal level, not the process: what was reached, what is being done now and where it is stuck, what the user has to do, with links to the evidence (merged PR, deployed and checked page, document). Send one when a task of yours was reached and at each report cycle (your scheduled check-in, or the end of a day's work on the direction); not after every step, and never only to say you are still working. It does not message the user: it becomes a progress line of your direction in the work-log extension's card, and the latest one is kept on the direction. What needs the user's decision now still goes by task_review needs_user.",
    "input_schema": {
      "type": "object",
      "properties": {
        "reached": {
          "type": "string",
          "description": "what was reached since the last report, one sentence (Chinese unless the user writes otherwise); empty when nothing was"
        },
        "doing": {
          "type": "string",
          "description": "what is being done now and, if stuck, where and on what; one sentence"
        },
        "needs_you": {
          "type": "string",
          "description": "what the user has to do (decide, verify, give access), with where; empty when nothing"
        },
        "links": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string"
          },
          "description": "evidence links: PRs, deployed pages, documents; the first is shown first"
        }
      }
    }
  },
  {
    "name": "subscription_list",
    "description": "List the user's source subscriptions: each pulls one connector source's read-only tool on a schedule into the Inbox and / or the knowledge base. Each line has its id, label, connector, source, tool, mode, kind, interval (or daily time for a snapshot), the two destination switches, its state (`off` both destinations off, `ok`, `failing`, `not_connected`, `rate_limited`, `needs_recipe`) with its error, the last run, the last successful run, the next run, how many new items the last run brought, and its revision (what subscription_save takes). A push source (filled by a device's shortcut) has no tool or schedule. Times are UTC; `time_zone` is the user's.",
    "input_schema": {
      "type": "object",
      "properties": {
        "connector": {
          "type": "string",
          "description": "only this connector's"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "subscription_get",
    "description": "Read one subscription in full: its whole recipe (mode, tool, args, items_path, fields, kind, group_by) and where it came from, its schedule, destinations, triage rules, fallback tier, state and error, the shape of the last result, its newest runs (newest first: when, how long, trigger, new and total items, `baseline` items recorded without delivering, error) and its newest held items as samples (title, sender, time, thread, link, the body cut to 300 characters). Use it before changing a subscription, for its revision and current values. A message whose `\u003cpersona-context\u003e` is about a subscription (the subscription page's \"configure with the assistant\") names `subscription`: read that one first; one naming only `connector` and `source` is a source not subscribed yet: start with subscription_sources for them.",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "the subscription's id (subscription_list)"
        },
        "runs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "description": "how many runs, default 5"
        },
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "description": "how many newest items, default 5"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "subscription_sources",
    "description": "What can be subscribed to, and how a recipe is written. Without `connector`: every connector's sources as last read (never a call), each with its tools (refused ones with the reason's code), how many recipes of its own it ships and its subscriptions; connectors not read yet are named. With `connector` (and `source`): that connector's catalog read now, each tool's description and `input_schema`, `subscribable` or `refused` with why, the source's own recipes and `min_interval_seconds`. Every answer has `recipe_format`, taken from the code: the recipe's keys, the `fields` keys and what each fills, path syntax, `items_path`, the template variables `{{since}}` / `{{since_date}}`, the modes, kinds, what each `group_by` makes of the Inbox rows and knowledge-base chats, and interval rules. Only read-only tools whose names say no write can be subscribed to.",
    "input_schema": {
      "type": "object",
      "properties": {
        "connector": {
          "type": "string",
          "description": "read this connector's catalog now, with input schemas"
        },
        "source": {
          "type": "string",
          "description": "with connector: only this source"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "subscription_dry_run",
    "description": "Try a recipe once without saving anything: it calls the tool and answers `dry_run` (`ok`, the five `checks` read_only, args, fields, dedup, interval with their errors; `count` items, `maybe_more` when a full page was all new, `items_path` where the items were found, up to 3 sample `items` as the Inbox would show them (title, sender, time, `summary` the row's preview line, and `problems`: the mapped fields that item has no readable value for), the first item's leaf `paths` with examples for writing `fields`, and `warnings`) and `recipe`, the recipe tried with its items_path filled in, to pass to subscription_save. Warnings do not fail a dry run but mean the recipe will not do what it seems: `unknown_key` (a key the format does not know, such as `fields.author` or `fields.url`: it is dropped and its column stays empty; use the keys in recipe_format) and `empty_field` (a mapped field whose path is empty in every item pulled). Give a subscription's `id` to try its own recipe, or a change to it: `recipe` is then merged onto its recipe (keys given replace, null removes, objects such as fields and args merge). Give `connector` and `source` with a whole `recipe` for a source not subscribed yet (no recipe: the source's own). Leave `items_path` out to have it found.",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "an existing subscription: try its recipe, or recipe merged onto it"
        },
        "connector": {
          "type": "string",
          "description": "without id: the connector"
        },
        "source": {
          "type": "string",
          "description": "without id: the source"
        },
        "recipe": {
          "type": "object",
          "description": "a recipe, or with id the change to its recipe: {mode, tool, args, items_path, fields, kind, group_by} (subscription_sources recipe_format)"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "subscription_save",
    "description": "Create, change or delete a subscription for the user. Each save puts a card on the user's phone saying what changes (before → after, and for a destination turned on what is pulled, how often, where it is kept and which model triages it); nothing changes until they approve it there, and an unanswered card changes nothing. Change only what the user asked for. `create` needs `connector` and `source` (subscription_sources) and takes a whole `recipe` (none: the source's own); it starts with both destinations off unless you set `to_inbox` / `to_kb`. `update` and `delete` need `id` and the `revision` subscription_get or subscription_list showed (a changed one is a conflict: read it again). On update, give only what changes: `label`, `recipe` (merged onto the current recipe as subscription_dry_run does), `interval_seconds`, `daily_at` (snapshots, HH:MM), `triage_rules`, `fallback_tier`, `to_inbox`, `to_kb`, or `pause` (both destinations off: nothing is pulled until one is turned on again). A recipe is dry-run first; one that fails, or has keys the format does not know, is not saved and the answer says why. When the recipe changes, `existing` says what happens to what the new recipe finds at once (it is all new to the subscription): `digest` (default) brings more than 3 into the Inbox as one digest row, as when the Inbox is turned on; `baseline` records them as seen and delivers none, for when they were delivered before (for example only the field mapping changed); `deliver` brings each in as new. `delete_data` with delete also removes what it added to the Inbox and the knowledge base. The answer has the saved subscription and, for an update, `previous`: the values to put it back with another save.",
    "input_schema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "create",
            "update",
            "delete"
          ]
        },
        "id": {
          "type": "string",
          "description": "update / delete: the subscription"
        },
        "revision": {
          "type": "integer",
          "description": "update / delete: the revision you read"
        },
        "connector": {
          "type": "string",
          "description": "create: the connector"
        },
        "source": {
          "type": "string",
          "description": "create: the source"
        },
        "label": {
          "type": "string",
          "description": "the name the user sees"
        },
        "recipe": {
          "type": "object",
          "description": "create: the whole recipe; update: the change to it"
        },
        "existing": {
          "type": "string",
          "enum": [
            "digest",
            "baseline",
            "deliver"
          ],
          "description": "with a recipe that changes: what its first finds become, default digest"
        },
        "interval_seconds": {
          "type": "integer",
          "description": "how often to pull, at least 300 and the source's minimum (a snapshot at least 3600)"
        },
        "daily_at": {
          "type": "string",
          "description": "a snapshot's daily time, HH:MM in the user's zone; \"\" to use interval_seconds"
        },
        "triage_rules": {
          "type": "string",
          "description": "rules for triaging its items in the Inbox; \"\" for the extension's or the Inbox's own"
        },
        "fallback_tier": {
          "type": "string",
          "enum": [
            "fyi",
            "action",
            "wait"
          ],
          "description": "without a triage model: fyi, action, wait for the model, or \"\" to clear (FYI; Needs you if due)"
        },
        "to_inbox": {
          "type": "boolean",
          "description": "add its items to the Inbox"
        },
        "to_kb": {
          "type": "boolean",
          "description": "save its items to the knowledge base"
        },
        "pause": {
          "type": "boolean",
          "description": "turn both destinations off"
        },
        "delete_data": {
          "type": "boolean",
          "description": "delete: also remove what it added to the Inbox and the knowledge base"
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "subscription_run",
    "description": "Run a subscription once now, as Pull Now on its page does (also while both destinations are off), and wait for the run: it answers the run (when, how long, new and total items, `baseline` items recorded without delivering, error), the subscription's state after it and up to 5 of the new items. It runs as soon as the connector's limits allow (one call at a time, 20 seconds apart, an hourly budget, pauses after rate limits); past `wait_seconds` it answers that it is still waiting, and subscription_get shows the run later. A push source cannot be run.",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "the subscription (subscription_list)"
        },
        "wait_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120,
          "description": "how long to wait for the run, default 60"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "github_search",
    "description": "Search GitHub as the user (their gh login on one of their machines). kind \"issues\" (default) finds issues and pull requests with GitHub's search syntax, e.g. \"is:pr is:open review-requested:@me\", \"involves:@me is:open updated:\u003e2026-01-01\", \"repo:owner/name label:bug\"; add involves:@me unless the user asked about something wider. kind \"code\" searches code (\"repo:owner/name symbol\"). Returns one line per result with its repo#number, state, title, author, last update and URL; read one with github_read.",
    "input_schema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "GitHub search query"
        },
        "kind": {
          "type": "string",
          "enum": [
            "issues",
            "code"
          ],
          "description": "issues (issues and pull requests, the default) or code"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "How many results (default 20)"
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "github_read",
    "description": "Read one GitHub pull request or issue: title, state, author, labels, the description, and for a pull request its branches, merge state, requested reviewers and reviews; then its comments, newest first (long texts are cut). Use github_diff for what a pull request changes and github_checks for its CI.",
    "input_schema": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "owner/name"
        },
        "number": {
          "type": "integer",
          "description": "The issue or pull request number"
        },
        "comments": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50,
          "description": "How many of the newest comments and reviews to include (default 15)"
        }
      },
      "required": [
        "repo",
        "number"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "github_diff",
    "description": "What a GitHub pull request changes. Without path: every changed file with its status and lines added / removed. With path: that file's patch (cut when very long; a file too big for GitHub to show has only its counts).",
    "input_schema": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "owner/name"
        },
        "number": {
          "type": "integer",
          "description": "The pull request number"
        },
        "path": {
          "type": "string",
          "description": "One changed file's path, for its patch"
        }
      },
      "required": [
        "repo",
        "number"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "github_checks",
    "description": "The checks (CI) of a GitHub pull request's head commit, or of a commit / branch: each check's name, status and conclusion. For failed GitHub Actions jobs it adds the last part of the job's log, where the error usually is.",
    "input_schema": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "owner/name"
        },
        "number": {
          "type": "integer",
          "description": "A pull request number (its head commit is checked)"
        },
        "ref": {
          "type": "string",
          "description": "A commit SHA or branch name, instead of number"
        }
      },
      "required": [
        "repo"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "github_comment",
    "description": "Comment on a GitHub pull request or issue as the user. Everyone who can see the repository sees it (for a public repository, everyone), so the user approves each comment on their phone before it is posted, unless their rules allow it. Write what the user would write; never post on your own initiative what they have not asked for.",
    "input_schema": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "owner/name"
        },
        "number": {
          "type": "integer",
          "description": "The issue or pull request number"
        },
        "body": {
          "type": "string",
          "description": "The comment, Markdown"
        }
      },
      "required": [
        "repo",
        "number",
        "body"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "github_review",
    "description": "Submit a review on a GitHub pull request as the user: approve it, request changes, or comment. The user approves it on their phone first (an approval says so in bold), unless their rules allow it. Only approve when the user has said to.",
    "input_schema": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "owner/name"
        },
        "number": {
          "type": "integer",
          "description": "The pull request number"
        },
        "event": {
          "type": "string",
          "enum": [
            "APPROVE",
            "REQUEST_CHANGES",
            "COMMENT"
          ],
          "description": "APPROVE, REQUEST_CHANGES (body required) or COMMENT (body required)"
        },
        "body": {
          "type": "string",
          "description": "The review's text, Markdown"
        }
      },
      "required": [
        "repo",
        "number",
        "event"
      ],
      "additionalProperties": false
    }
  }
]
