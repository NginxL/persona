[Unit]
Description=Persona maintainer main verification watcher
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/persona/scripts/operations
Environment=MAIN_WATCH_CONFIG=%h/.config/persona/main-watch.json
EnvironmentFile=-%h/.config/persona/main-watch.env
ExecStart=/usr/bin/python3 -I /opt/persona/scripts/operations/main_watch.py
Restart=always
RestartSec=10
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
